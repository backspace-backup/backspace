<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Backspace.Views"
             x:Class="Backspace.App"
             RequestedThemeVariant="Light">

  <!-- System-tray icon. Visible by default so users who close the
       main window can still reach the app (and so scheduled backups
       don't feel "gone" when the window isn't on screen). Code-behind
       wires Click → restore-window + the context menu. -->
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://Backspace/Assets/Backspace.ico"
                ToolTipText="Backspace"
                Clicked="OnTrayIconClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show Backspace" Click="OnTrayShow"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Quit Backspace" Click="OnTrayQuit"/>
            <NativeMenuItem Header="Force quit…" Click="OnTrayForceQuit"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.DataTemplates>
    <v:ViewLocator/>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Backspace/Themes/Controls.axaml"/>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Backspace/Themes/Theme.axaml"/>
        <!-- Default accent merged statically so DynamicResource lookups for
             BS.Brush.Accent etc. resolve at template-parse time. Without
             this, any ControlTemplate authored with DynamicResource for an
             accent brush evaluates before code-behind has merged the user's
             chosen accent dict, caches a failed lookup in that template
             context, and never updates. Code-behind
             (App.ApplyAccentFromConfig) still swaps in the user's preferred
             accent on top of this default. -->
        <ResourceInclude Source="avares://Backspace/Themes/Accent_Ocean.axaml"/>
        <ResourceInclude Source="avares://Backspace/Themes/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
