<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Backspace.ViewModels"
        xmlns:v="using:Backspace.Views"
        x:Class="Backspace.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Backspace"
        Icon="avares://Backspace/Assets/Backspace.ico"
        Width="1180" Height="760"
        MinWidth="920" MinHeight="540"
        Background="{DynamicResource BS.Brush.BgBase}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="32">

  <Window.Styles>
    <Style Selector="Button.protection-card">
      <Setter Property="Background" Value="{DynamicResource BS.Brush.WarnTint}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BS.Brush.WarnLightBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="ProtectionCardSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Stretch"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.protection-card:pointerover /template/ Border#ProtectionCardSurface">
      <Setter Property="Background" Value="{DynamicResource BS.Brush.WarnTintHover}"/>
    </Style>
    <Style Selector="Button.protection-card:focus-visible /template/ Border#ProtectionCardSurface">
      <Setter Property="BorderBrush" Value="{DynamicResource BS.Brush.WarnTintFg}"/>
      <Setter Property="BoxShadow" Value="0 0 0 1 #B45309"/>
    </Style>
    <!-- Files in use may be skipped (U027, 29 October 2026): a compact
         warning in the sidebar instead of a banner over the backups list;
         clicking it explains the problem and offers the fix. Nothing shows
         once administrator access is on. -->
    <Style Selector="Button.access-badge">
      <Setter Property="Background" Value="{DynamicResource BS.Brush.WarnLightBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BS.Brush.WarnLightBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.WarnLightFg}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="AccessBadgeSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.access-badge:pointerover /template/ Border#AccessBadgeSurface">
      <Setter Property="Background" Value="{DynamicResource BS.Brush.WarnLightBgHover}"/>
    </Style>
    <Style Selector="Button.access-badge:focus-visible /template/ Border#AccessBadgeSurface">
      <Setter Property="BorderBrush" Value="{DynamicResource BS.Brush.WarnLightFg}"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="32,*,Auto">

    <!-- ========================================================= -->
    <!-- Main content: sidebar + current page                        -->
    <!-- ========================================================= -->
    <Grid Grid.Row="0" Grid.RowSpan="2" ColumnDefinitions="248,*">

      <!-- ========== Sidebar ========== -->
      <Border Grid.Column="0"
              Background="{DynamicResource BS.Brush.Sidebar}"
              BorderBrush="{DynamicResource BS.Brush.BorderSubtle}"
              BorderThickness="0,0,1,0">
        <Panel>
        <!-- A faint wash of the chosen accent, so the chrome carries it. -->
        <Border Background="{DynamicResource BS.Brush.AccentTint}" Opacity="0.35" IsHitTestVisible="False"/>
        <DockPanel LastChildFill="True">

          <!--
            Masthead. Logo (per-accent ICO swapped by code-behind on a
            160 ms timer for the syncing animation) + wordmark. The
            Manrope wordmark matches the large page headings; native
            text remains on every navigation label. A thin rule below
            separates the identity from the compact navigation group.
            User feedback: "YOUR BACKUPS" caps label between the
            masthead and the nav was redundant — the two items
            underneath ARE the primary nav, no group label needed.
          -->
          <Grid DockPanel.Dock="Top" Margin="18,12,18,16" Background="Transparent"
                ColumnDefinitions="32,*" VerticalAlignment="Center"
                PointerPressed="OnTitleBarPressed">
            <Image Grid.Column="0" Name="SidebarLogo" Width="32" Height="32"
                   Source="avares://Backspace/Assets/Backspace.ico"/>
            <TextBlock Grid.Column="1" Text="Backspace"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       FontFamily="{DynamicResource BS.Font.Heading}"
                       FontSize="19" FontWeight="Bold" LetterSpacing="-0.4"
                       LineHeight="26"
                       Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
          </Grid>


          <!-- Primary nav. "Restore files" was removed from here — the
               per-backup BackupCard now hosts a "Restore files" button
               that takes the user to the same wizard, scoped to that
               backup. The "WHEN SOMETHING HAPPENS" group label was also
               dropped — Activity & logs is a supporting diagnostics
               feature and now sits below Settings. -->
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <RadioButton Classes="nav" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={x:Static v:NavConverters.IsSelected}, ConverterParameter={x:Static vm:NavItem.Backups}, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.Backup}" Width="16" Height="16"/>
                <TextBlock Text="Backups" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={x:Static v:NavConverters.IsSelected}, ConverterParameter={x:Static vm:NavItem.Destinations}, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.Destinations}" Width="16" Height="16"/>
                <TextBlock Text="Destinations" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <!-- ===== Active restores nav item =====
                 Shows ONLY while a restore is in flight (bound to
                 HasActiveRestores). The download-arrow icon animates
                 a subtle pulse via the "restoring" style class to
                 mirror the syncing taskbar icon. Click → returns the
                 user to the live progress view they navigated away
                 from. ROADMAP item 8 covers the multi-restore
                 evolution (cards listing each parallel restore);
                 today's single-VM architecture supports one restore
                 at a time, so this nav item directly opens the live
                 Restore page when clicked. -->
            <RadioButton Classes="nav" GroupName="nav"
                         IsVisible="{Binding HasActiveRestores}" Click="OnRestoresNavClick"
                         IsChecked="{Binding SelectedNav, Converter={x:Static v:NavConverters.IsSelected}, ConverterParameter={x:Static vm:NavItem.ActiveRestores}, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Classes.active-restore-icon="{Binding HasRunningRestores}"
                          Data="{StaticResource Icon.ArrowDownTray}" Width="16" Height="16"/>
                <TextBlock Text="Restores" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>

          <!-- Supporting navigation stays near the primary routes; the
               small rule separates roles without stranding two links at
               the bottom of a tall, otherwise empty sidebar. -->
          <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0" Spacing="2">
            <RadioButton Classes="nav" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={x:Static v:NavConverters.IsSelected}, ConverterParameter={x:Static vm:NavItem.Settings}, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.Settings}" Width="16" Height="16"/>
                <TextBlock Text="Settings" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={x:Static v:NavConverters.IsSelected}, ConverterParameter={x:Static vm:NavItem.Logs}, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.Activity}" Width="16" Height="16"/>
                <TextBlock Text="Activity &amp; logs" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

          </StackPanel>

          <!-- Provenance remains anchored to the bottom. -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14" Spacing="2">
            <Button Name="AdministratorAccessBadge" Classes="access-badge" Margin="16,0,16,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    IsVisible="{Binding Backups.NeedsAdministratorAccess}"
                    AutomationProperties.Name="{Binding AdministratorAccess.Title, StringFormat='{}{0}. Show details.'}">
              <Grid ColumnDefinitions="Auto,8,*,6,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.Warn}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                          Foreground="{DynamicResource BS.Brush.WarnLightFg}"/>
                <TextBlock x:Name="AdministratorAccessBadgeText" Grid.Column="2" Text="{Binding AdministratorAccess.Title}" FontSize="12" LineHeight="17"
                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.WarnLightFg}"/>
                <PathIcon Grid.Column="4" Data="{StaticResource Icon.ChevronRight}" Width="11" Height="11" VerticalAlignment="Center"
                          Foreground="{DynamicResource BS.Brush.WarnLightFg}"/>
              </Grid>
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom">
                  <StackPanel Width="320" Spacing="10" DataContext="{Binding AdministratorAccess}" x:DataType="vm:BackgroundBackupViewModel">
                    <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                    <TextBlock Classes="helper" Margin="0" TextWrapping="Wrap" Text="{Binding Detail}"/>
                    <TextBlock Classes="body" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.WarnLightFg}"
                               Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static vm:NotEmpty.To}}"/>
                    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}"/>
                    <StackPanel Spacing="6">
                      <Button x:Name="AllowAccessFromBadge" Classes="primary" Content="{Binding ActionText}" HorizontalAlignment="Left"
                              Click="OnAllowAdministratorAccess" IsEnabled="{Binding CanApply}"/>
                      <TextBlock Classes="helper" Margin="0" TextWrapping="Wrap" Text="{Binding ActionHint}"
                                 IsVisible="{Binding ActionHint, Converter={x:Static vm:NotEmpty.To}}"/>
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Name="LimitedProtectionButton" Classes="protection-card" Margin="16,0,16,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasLimitedProtection}"
                    AutomationProperties.Name="Limited protection. Snapshots are off. Review protection."
                    Click="OnLimitedProtection">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="16,8,*">
                  <PathIcon Data="{StaticResource Icon.Warn}" Width="16" Height="16"
                            Foreground="{DynamicResource BS.Brush.WarnTintFg}" VerticalAlignment="Center"/>
                  <TextBlock Name="ProtectionCardHeading" Grid.Column="2" FontSize="14" LineHeight="20"
                             FontWeight="SemiBold" Foreground="{DynamicResource BS.Brush.FgPrimary}"
                             Text="Limited protection"/>
                </Grid>
                <TextBlock Name="ProtectionCardExplanation" FontSize="13" LineHeight="19"
                           Foreground="{DynamicResource BS.Brush.FgPrimary}" TextWrapping="Wrap"
                           Text="Snapshots are off.&#10;Open files may be missed."/>
                <Grid ColumnDefinitions="*,14" Margin="0,3,0,0">
                  <TextBlock Name="ProtectionCardAction" FontSize="13" LineHeight="20" FontWeight="SemiBold"
                             Foreground="{DynamicResource BS.Brush.WarnTintFg}" Text="Review protection"/>
                  <PathIcon Name="ProtectionCardArrow" Grid.Column="1" Data="{StaticResource Icon.ArrowRight}"
                            Width="14" Height="14" VerticalAlignment="Center"
                            Foreground="{DynamicResource BS.Brush.WarnTintFg}"/>
                </Grid>
              </StackPanel>
            </Button>
            <!-- Footer: dropped the redundant app-name line — the
                 sidebar masthead already says "Backspace". What's
                 actually useful here:
                   1. Attribution + provenance — "Powered by Backrest"
                      with the engine name as a clickable link to the
                      Backrest GitHub repo (the upstream Go daemon
                      this app embeds for the restic-driven backup
                      engine).
                   2. Repo link — GitHub Octocat for "where do I
                      report a bug / read the source".
                   3. Version — small, dim, on its own line so it stays
                      out of the way for users who don't care AND
                      visible for users filing a bug report.
                 Two-row layout keeps both rows breathable rather than
                 cramming three elements into one line at 12px. -->
            <Border Classes="rule" Margin="24,16,24,12"/>
            <!-- Two-line footer:
                   Row 1: GitHub Octocat (the only interactive control —
                          for bug reports / source) + version text.
                   Row 2: "Powered by Backrest" attribution; the engine
                          name is a small text-link that opens the
                          Backrest GitHub.
                 Tight Spacing="2" between the two rows so the block
                 reads as one footer unit, not two stacked items. -->
            <StackPanel Margin="26,0,16,0" Spacing="2">
              <Grid ColumnDefinitions="Auto,8,Auto,*" VerticalAlignment="Center">
                <Button Grid.Column="0" Classes="github-link"
                        ToolTip.Tip="View on GitHub"
                        Click="OnOpenGitHub">
                  <PathIcon Classes="filled"
                            Data="{StaticResource Icon.GitHub}"
                            Width="16" Height="16"/>
                </Button>
                <TextBlock x:Name="FooterVersionText" Grid.Column="2"
                           Classes="dim" FontSize="11"
                           VerticalAlignment="Center"/>
              </Grid>
              <!-- "Powered by Backrest" with the engine name as a
                   clickable link to the Backrest GitHub repo. -->
              <!-- Spacing=2 (was 4) — the natural font sidebearings of
                   the trailing "y" + leading "B" already provide ~6px
                   of visual whitespace, so a 4px container gap on top
                   produced "Powered by   Backrest" with a too-wide
                   hole. -->
              <StackPanel Orientation="Horizontal" Spacing="2"
                          Margin="0,0,0,2">
                <TextBlock Text="Powered by"
                           Classes="dim" FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Classes="text-link"
                        Click="OnOpenBackrest"
                        ToolTip.Tip="Open the Backrest GitHub repo">
                  <TextBlock Text="Backrest" FontSize="12"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Border/>
        </DockPanel>
        </Panel>
      </Border>

      <!-- ========== Content host ========== -->
      <ContentControl Grid.Column="1" Margin="0,32,0,0" Content="{Binding CurrentPage}"/>
    </Grid>

    <!-- ========================================================= -->
    <!-- Custom title bar, 32px like Windows 11 caption buttons. It is  -->
    <!-- declared after the content so it paints on top of it. The    -->
    <!-- sidebar runs to the top edge underneath column 0 (its         -->
    <!-- masthead is draggable too); the content column starts below   -->
    <!-- this row (U030, 29 October 2026).                             -->
    <!-- ========================================================= -->
    <Grid Grid.Row="0" ColumnDefinitions="248,*,Auto"
          PointerPressed="OnTitleBarPressed">

      <!-- Drag region over the content column. -->
      <Border Grid.Column="1" Background="{DynamicResource BS.Brush.BgBase}"/>

      <!-- Window buttons: minimize, maximize/restore, close. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource BS.Brush.BgBase}">
        <Button Classes="win-button" Name="MinBtn" Click="OnMinimize"
                ToolTip.Tip="Minimize"
                AutomationProperties.Name="Minimize">
          <!-- Horizontal bar. No Stretch: the geometry is 0px tall so
               Stretch="Uniform" renders nothing. -->
          <Path Data="M2,6 L12,6" Stroke="{DynamicResource BS.Brush.FgPrimary}"
                StrokeThickness="1.6" Width="14" Height="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button Classes="win-button" Name="MaxBtn" Click="OnMaximize"
                ToolTip.Tip="Maximize"
                AutomationProperties.Name="Maximize">
          <Path Data="M3 3h10v10H3z" Stroke="{DynamicResource BS.Brush.FgPrimary}"
                StrokeThickness="1.6" Fill="Transparent" Width="12" Height="12" Stretch="Uniform"/>
        </Button>
        <Button Classes="win-button win-close" Name="CloseBtn" Click="OnClose"
                ToolTip.Tip="Close"
                AutomationProperties.Name="Close">
          <Path Data="M3 3l10 10M13 3L3 13" Stroke="{DynamicResource BS.Brush.FgPrimary}"
                StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>

    <v:FileWaitPanel Grid.Row="2"/>
  </Grid>
</Window>
