<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Backspace.ViewModels"
             xmlns:m="using:Backspace.Models"
             xmlns:svc="using:Backspace.Services"
             xmlns:v="using:Backspace.Views"
             x:Class="Backspace.Views.LogsView"
             x:Name="Root"
             x:DataType="vm:LogsViewModel"
             Background="{DynamicResource BS.Brush.BgBase}">

  <UserControl.Resources>
    <!-- Console-only tokens. Everything else in the console uses the
         theme's dark-variant colours (the console sits in a dark theme
         scope), so status colours read on it in both app themes. -->
    <SolidColorBrush x:Key="BS.Brush.ConsoleFg" Color="#D7DCE2"/>
    <SolidColorBrush x:Key="BS.Brush.ConsoleTag" Color="#6E7681"/>
    <SolidColorBrush x:Key="BS.Brush.ConsoleRule" Color="#2A3340"/>
    <SolidColorBrush x:Key="BS.Brush.ConsoleSelection" Color="#264F78"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The console stays dark in either app theme. Theme-wide ghost
         hover colors can be pale, so keep these actions on the console
         palette instead of washing out their light labels. -->
    <Style Selector="Button.console-action:pointerover /template/ Border#RootBorder">
      <Setter Property="Background" Value="#303C4B"/>
    </Style>
    <Style Selector="Button.console-action:pressed /template/ Border#RootBorder">
      <Setter Property="Background" Value="#3A4859"/>
      <Setter Property="BorderBrush" Value="#6B7C92"/>
    </Style>
    <!-- A past run's outcome, tinted on the console palette like LIVE. -->
    <Style Selector="Border.run-status">
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="#1F2630"/>
    </Style>
    <Style Selector="Border.run-status > TextBlock">
      <Setter Property="FontWeight" Value="700"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#C9D1D9"/>
    </Style>
    <Style Selector="Border.run-status.ok"><Setter Property="Background" Value="#163D2B"/></Style>
    <Style Selector="Border.run-status.ok > TextBlock"><Setter Property="Foreground" Value="#86E7AB"/></Style>
    <Style Selector="Border.run-status.warn"><Setter Property="Background" Value="#3D2E12"/></Style>
    <Style Selector="Border.run-status.warn > TextBlock"><Setter Property="Foreground" Value="#F5C26B"/></Style>
    <Style Selector="Border.run-status.fail"><Setter Property="Background" Value="#4A1C1C"/></Style>
    <Style Selector="Border.run-status.fail > TextBlock"><Setter Property="Foreground" Value="#FF9A9A"/></Style>

    <!-- Header buttons: one size, the console's palette. -->
    <Style Selector="Button.console-header">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="#1F2630"/>
      <Setter Property="BorderBrush" Value="#2A3340"/>
      <Setter Property="Foreground" Value="#C9D1D9"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Header switches: the theme's unticked box outline is invisible on
         the dark console header. -->
    <Style Selector="CheckBox.console-switch">
      <Setter Property="Foreground" Value="#C9D1D9"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="BorderBrush" Value="#8B949E"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Console lines (U176): colour by line type. -->
    <Style Selector="v|ConsoleLineRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
    <Style Selector="v|ConsoleLineRow.selected">
      <Setter Property="Background" Value="{StaticResource BS.Brush.ConsoleSelection}"/>
    </Style>
    <Style Selector="v|ConsoleLineRow.flash">
      <Setter Property="Background" Value="{DynamicResource BS.Brush.DangerLightBg}"/>
    </Style>
    <Style Selector="TextBlock.ln, TextBlock.ln-time">
      <Setter Property="FontFamily" Value="{DynamicResource BS.Font.Mono}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="LineHeight" Value="19"/>
      <Setter Property="Foreground" Value="{StaticResource BS.Brush.ConsoleFg}"/>
    </Style>
    <Style Selector="TextBlock.ln-time">
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.FgDim}"/>
      <Setter Property="Width" Value="68"/>
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ItemsControl.stamps TextBlock.ln-time">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="TextBlock.ln-setup, TextBlock.ln-meta, TextBlock.ln-detail, TextBlock.ln-notice">
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.FgDim}"/>
    </Style>
    <Style Selector="TextBlock.ln-notice">
      <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <Style Selector="TextBlock.ln-progress">
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.FgSecondary}"/>
    </Style>
    <Style Selector="TextBlock.ln-warning">
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.WarnTintFg}"/>
    </Style>
    <Style Selector="TextBlock.ln-error">
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.DangerTintFg}"/>
    </Style>
    <Style Selector="TextBlock.ln-summary">
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.AccentTintFg}"/>
    </Style>
    <Style Selector="TextBlock.ln-blank">
      <Setter Property="LineHeight" Value="10"/>
    </Style>
    <!-- Where a run, a check or a cleanup starts: a thin rule, a bold header. -->
    <Style Selector="TextBlock.ln-section">
      <Setter Property="FontFamily" Value="{DynamicResource BS.Font.Body}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.FgPrimary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="v|ConsoleLineRow.ln-section TextBlock.ln-time">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.ln-rule">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{StaticResource BS.Brush.ConsoleRule}"/>
      <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style Selector="TextBlock.ln-subtitle">
      <Setter Property="FontFamily" Value="{DynamicResource BS.Font.Body}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.FgDim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="12,0,8,0"/>
      <Setter Property="MaxWidth" Value="320"/>
    </Style>
    <Style Selector="Button.ln-copy">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A8B3C1"/>
    </Style>
    <!-- The failed run's errors, above its log. -->
    <Style Selector="Button.error-jump">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
  </UserControl.Styles>

  <Grid Margin="32,4,32,32" RowDefinitions="Auto,Auto,*">

    <StackPanel Grid.Row="0" Margin="0,0,0,24">
      <TextBlock Classes="page-title" Text="Activity &amp; logs"/>
      <TextBlock Classes="page-subtitle" MaxWidth="720"
                 Text="Follow current activity or revisit a past run."/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,0,0,14"
          IsVisible="{Binding !HasNoBackups}">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Classes="label-caps" Text="BACKUP"/>
        <ComboBox x:Name="BackupPicker" ItemsSource="{Binding BackupNames}"
                  SelectedItem="{Binding SelectedBackup}"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Pick a backup"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock Classes="label-caps" Text="RUN"/>
        <ComboBox x:Name="RunPicker" ItemsSource="{Binding History}"
                  SelectedItem="{Binding SelectedRun}"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Pick a run">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="m:RunRecord">
              <!-- Compose the row text from a converter rather than
                   chained <Run> elements: the in-flight synthetic
                   RunRecord has Status=Running AND Summary="Running…",
                   which used to render as "12:34 · Running · Running…"
                   with the same word duplicated. The converter folds
                   that case (Summary mirrors Status) into a single
                   "12:34 · Running…" line. -->
              <TextBlock Text="{Binding ., Converter={x:Static vm:RunRecordRowText.To}}"
                         TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>

    <!-- Empty state: zero configured backups. Without this the user
         lands on the Logs tab with two empty ComboBoxes above two empty
         cream surfaces — no guidance on why the page is dead and no
         way back to setting up a backup. -->
    <Border Grid.Row="2" Classes="empty-state"
            IsVisible="{Binding HasNoBackups}"
            VerticalAlignment="Top">
      <Grid ColumnDefinitions="Auto,20,*">
        <Border Grid.Column="0" Classes="empty-state-glyph">
          <PathIcon Data="{StaticResource Icon.FileText}"/>
        </Border>
        <StackPanel Grid.Column="2" Spacing="16">
          <TextBlock Classes="card-title" Text="No backups yet"/>
          <TextBlock Classes="body" TextWrapping="Wrap"
                     Text="Live output and run history will appear here once you set up a backup. The Backups tab is where to start."/>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Classes="primary" Command="{Binding GoToBackupsCommand}">
              <TextBlock Text="Go to Backups"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- A quiet, full-width console keeps output distinct from the
         controls. Header space is reserved for state, context and
         actions; there are no decorative window buttons. The console is
         dark in both app themes: its scope uses the dark theme's
         colours, so status colours (warnings, errors, the accent) read
         on it either way (U176). -->
    <ThemeVariantScope Grid.Row="2" RequestedThemeVariant="Dark"
                       IsVisible="{Binding !HasNoBackups}">
    <Border x:Name="Console"
            Background="#0E1116"
            BorderBrush="#1F2630"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
      <DockPanel LastChildFill="True">
        <!-- State appears once. Live output combines all operations;
             only a historical run has a run-specific log. -->
        <Border DockPanel.Dock="Top"
                Background="#161B22"
                BorderBrush="#1F2630"
                BorderThickness="0,0,0,1"
                Padding="14,8">
          <Grid x:Name="ConsoleHeader" ColumnDefinitions="*,Auto,8,Auto,12,Auto,12,Auto,8,Auto" VerticalAlignment="Center">
            <!-- Grid so a long backup name ellipsizes before running
                 under the Copy/Clear buttons (horizontal StackPanels
                 give the label infinite measure width). -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center" Margin="0,0,14,0">
              <Grid Grid.Column="0" IsVisible="{Binding !HasNoHistoryForSelected}">
              <Border x:Name="LiveBadge" Background="#163D2B"
                      CornerRadius="5"
                      Padding="8,4" Margin="0,0,10,0"
                      IsVisible="{Binding IsShowingLive}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Width="5" Height="5" Fill="#86E7AB"/>
                  <TextBlock Text="LIVE"
                             Foreground="#86E7AB"
                             FontWeight="700" FontSize="11"
                             LetterSpacing="0.6"/>
                </StackPanel>
              </Border>
              </Grid>
              <TextBlock x:Name="ConsoleContext" Grid.Column="1" Text="{Binding DisplayContext}"
                         FontFamily="{DynamicResource BS.Font.Body}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="#C9D1D9"
                         HorizontalAlignment="Left"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding DisplayLabel}"
                         VerticalAlignment="Center"/>
              <Border x:Name="RunStatusChip" Grid.Column="2" Classes="run-status"
                      HorizontalAlignment="Left"
                      Classes.ok="{Binding RunStatusIsOk}"
                      Classes.warn="{Binding RunStatusIsWarn}"
                      Classes.fail="{Binding RunStatusIsFail}"
                      IsVisible="{Binding RunStatusLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding RunStatusLabel}"/>
              </Border>
            </Grid>
            <Button x:Name="CopyLog" Grid.Column="1"
                    Classes="ghost console-action console-header"
                    Command="{Binding CopyDisplayedCommand}"
                    ToolTip.Tip="Copy the shown log to the clipboard. Select lines first (drag, or Ctrl+A) to copy only those with Ctrl+C.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Copy}" Width="12" Height="12"
                          Foreground="#C9D1D9"/>
                <TextBlock Text="Copy" VerticalAlignment="Center" Foreground="#C9D1D9" FontSize="12"/>
              </StackPanel>
            </Button>
            <!-- A saved run's log file, opened in the system's text editor. -->
            <Button x:Name="OpenLogFile" Grid.Column="3"
                    Classes="ghost console-action console-header"
                    Command="{Binding OpenLogFileCommand}"
                    IsVisible="{Binding CanOpenLogFile}"
                    ToolTip.Tip="{Binding LogFilePath}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.FileText}" Width="12" Height="12"
                          Foreground="#C9D1D9"/>
                <TextBlock Text="Open log file" VerticalAlignment="Center" Foreground="#C9D1D9" FontSize="12"/>
              </StackPanel>
            </Button>
            <!-- Display only: run logs keep every line, so switching
                 re-renders past lines too (U113). -->
            <CheckBox x:Name="VerboseLog" Grid.Column="5"
                      Classes="console-switch"
                      Content="Verbose"
                      IsChecked="{Binding ShowVerbose}"
                      ToolTip.Tip="Show every engine line, including debug details. Logs always record them; this changes only what is shown.">
              <CheckBox.Resources>
                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#8B949E"/>
                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#C9D1D9"/>
                <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#C9D1D9"/>
                <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#C9D1D9"/>
                <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="#FFFFFF"/>
              </CheckBox.Resources>
            </CheckBox>
            <!-- Each line's local time in a narrow column (U176). Remembered. -->
            <CheckBox x:Name="TimestampsLog" Grid.Column="7"
                      Classes="console-switch"
                      Content="Timestamps"
                      IsChecked="{Binding ShowTimestamps}"
                      ToolTip.Tip="Show the time each line was written, in a column on the left. Older logs did not record it.">
              <CheckBox.Resources>
                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#8B949E"/>
                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#C9D1D9"/>
                <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#C9D1D9"/>
                <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#C9D1D9"/>
                <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="#FFFFFF"/>
              </CheckBox.Resources>
            </CheckBox>
            <Button x:Name="ClearLog" Grid.Column="9"
                    Classes="ghost console-action console-header" Content="Clear view"
                    Command="{Binding ClearLiveCommand}"
                    ToolTip.Tip="Clear the live display. Saved run history is kept."
                    IsVisible="{Binding IsShowingLive}"/>
          </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="14,10" Background="#161B22">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static vm:BoolAnd.To}">
              <Binding Path="IsShowingLive"/>
              <Binding Path="!HasNoHistoryForSelected"/>
            </MultiBinding>
          </Border.IsVisible>
          <TextBlock x:Name="CombinedOutputHint" FontSize="12.5" Foreground="#A8B3C1"
                     TextWrapping="Wrap"
                     Text="This combines output from running backups and restores. Select a finished run above to read only that run’s saved log."/>
        </Border>

        <!-- A failed run's errors, each a link to its line (U176). -->
        <Border x:Name="ErrorList" DockPanel.Dock="Top"
                IsVisible="{Binding HasErrorList}"
                Background="#1E1214"
                BorderBrush="#1F2630" BorderThickness="0,0,0,1"
                Padding="12,10,12,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4,0,0,4">
              <PathIcon Data="{StaticResource Icon.Warn}" Width="13" Height="13"
                        Foreground="{DynamicResource BS.Brush.DangerTintFg}"/>
              <TextBlock x:Name="ErrorListTitle" Text="{Binding ErrorListTitle}"
                         FontFamily="{DynamicResource BS.Font.Body}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource BS.Brush.DangerTintFg}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer MaxHeight="118" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ErrorItems" ItemsSource="{Binding ErrorLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="svc:ConsoleLine">
                    <Button Classes="ghost console-action error-jump"
                            Command="{Binding #Root.((vm:LogsViewModel)DataContext).JumpToLineCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Show this line in the log">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                   FontFamily="{DynamicResource BS.Font.Mono}" FontSize="12"
                                   Foreground="{DynamicResource BS.Brush.FgDim}" Margin="0,0,10,0"
                                   IsVisible="{Binding Time, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                   FontFamily="{DynamicResource BS.Font.Mono}" FontSize="12"
                                   Foreground="{DynamicResource BS.Brush.DangerTintFg}"
                                   TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- One row per line in a virtualizing list (U176): a log of
             100,000 lines scrolls smoothly, and each line has its own
             colour. Lines wrap, so there is no horizontal bar: a long
             recap or error line used to add one and push its end out of
             sight (U113). An explicit ScrollViewer (not a TextBox's own)
             keeps the scrollbar at the console's edge. Select lines by
             dragging over them (Ctrl+A for all); Ctrl+C copies them. -->
        <Grid>
          <ScrollViewer x:Name="LogScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        AllowAutoHide="False"
                        Background="Transparent"
                        Focusable="True"
                        ScrollChanged="OnLogScrollChanged">
            <ItemsControl x:Name="LogLines"
                          ItemsSource="{Binding DisplayLines}"
                          Classes.stamps="{Binding ShowTimestamps}"
                          Background="Transparent"
                          Padding="12,10,12,16">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="svc:ConsoleLine">
                  <v:ConsoleLineRow/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="CopySelectedMenu" Header="Copy selected lines" InputGesture="Ctrl+C" Click="OnCopySelected"/>
                  <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="OnSelectAll"/>
                  <MenuItem Header="Copy all" Command="{Binding CopyDisplayedCommand}"/>
                </ContextMenu>
              </ItemsControl.ContextMenu>
            </ItemsControl>
          </ScrollViewer>
          <!-- Shown while the reader has scrolled away from the end (U083):
               new lines no longer pull them back; this returns and follows again. -->
          <Button x:Name="JumpToLatest" Classes="ghost" IsVisible="False"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                  Content="Jump to latest" Click="OnJumpToLatest"/>
          <!-- "No history for selected backup yet" placeholder.
               Shown when the user has picked a backup but it has
               never produced a RunRecord (fresh backup, all runs
               pruned). Without this the user stared at an empty
               black terminal pane with no hint that the dropdown
               was waiting on data they hadn't generated yet. -->
          <Border IsVisible="{Binding HasNoHistoryForSelected}"
                  Background="#0E1116"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" Margin="24"
                        VerticalAlignment="Center"
                        Spacing="10"
                        MaxWidth="380">
              <TextBlock Text="No runs yet for this backup"
                         HorizontalAlignment="Center"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="#C9D1D9"/>
              <TextBlock Text="Output will appear here the next time this backup runs. Click Run now on the backup card to start one."
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Foreground="#A8B3C1"/>
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Border>
    </ThemeVariantScope>
  </Grid>
</UserControl>
