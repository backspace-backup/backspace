<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Backspace.Views.GeneratedPasswordWindow"
        Title="Save this password - Backspace"
        Width="560" SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource BS.Brush.BgBase}"
        WindowStartupLocation="CenterOwner">

  <!--
    A generated password, in two steps (U250): first it is shown, with Copy,
    to be saved somewhere safe; then it is hidden, the clipboard cleared, and
    you type it back from where you saved it. Only then is it used, so a
    password nobody kept is never put in place. Closing at either step uses
    nothing.
  -->

  <StackPanel Margin="32,28,32,24" Spacing="18">
    <!-- Step 1: save it. -->
    <StackPanel Spacing="18" x:Name="ShowStep">
      <StackPanel Spacing="8">
        <TextBlock Classes="card-title" Text="Save this password somewhere safe"/>
        <TextBlock Classes="body" TextWrapping="Wrap" x:Name="ShowIntro"
                   Text="Backspace made this password for you and copied it. Save it in your password manager, or write it down and keep it somewhere safe."/>
        <TextBlock Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource BS.Brush.Danger}" x:Name="LossWarning"
                   Text="If you lose this password, the encrypted backups can't be recovered."/>
      </StackPanel>
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0" x:Name="PasswordBox" IsReadOnly="True"
                 FontFamily="{DynamicResource BS.Font.Mono}" FontSize="15"/>
        <Button Grid.Column="2" Classes="ghost" Click="OnCopy" x:Name="CopyButton">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Clipboard}" Width="13" Height="13"/>
            <TextBlock x:Name="CopyLabel" Text="Copy" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="ghost" Content="Cancel" Click="OnCancel" x:Name="CancelShowButton"/>
        <Button Classes="primary" Content="I've saved it" Click="OnSaved" x:Name="SavedButton"/>
      </StackPanel>
    </StackPanel>

    <!-- Step 2: type it back from where it was saved. -->
    <StackPanel Spacing="18" x:Name="CheckStep" IsVisible="False">
      <StackPanel Spacing="8">
        <TextBlock Classes="card-title" Text="Type it back from where you saved it"/>
        <TextBlock Classes="body" TextWrapping="Wrap"
                   Text="To be sure you can find it when you need it, type or paste the password from your password manager or your note. Backspace has removed it from the clipboard."/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="label-caps" Text="THE PASSWORD YOU SAVED"/>
        <TextBox x:Name="TypedBox" FontFamily="{DynamicResource BS.Font.Mono}" FontSize="15"
                 PlaceholderText="xxxxx-xxxxx-xxxxx-xxxxx-xxxxx"/>
        <TextBlock Classes="helper" x:Name="MismatchText" IsVisible="False" TextWrapping="Wrap"
                   Foreground="{DynamicResource BS.Brush.Danger}"
                   Text="That's not the same password. Check your note, or go back to see it again."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="ghost" Content="Show it again" Click="OnBack" x:Name="BackButton"/>
        <Button Classes="primary" Content="Use this password" Click="OnUse" x:Name="UseButton" IsEnabled="False"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
