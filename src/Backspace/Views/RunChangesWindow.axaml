<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Backspace.ViewModels" xmlns:v="using:Backspace.Views"
        x:Class="Backspace.Views.RunChangesWindow" x:DataType="vm:RunChangesViewModel"
        Title="What this backup added - Backspace" Width="1080" Height="720" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BS.Brush.BgBase}">
  <!-- U143 (5 November 2026): the files one backup added or changed, as a
       map of the folders they are in (area = bytes) and a list of the largest. -->
  <Grid Margin="24,20,24,18" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
    <StackPanel Spacing="4">
      <TextBlock Classes="page-title" Text="{Binding Title}"/>
      <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,10,*,Auto" Margin="0,14,0,10">
      <Button Grid.Column="0" Classes="ghost" Content="Up" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}"
              ToolTip.Tip="Back to the folder that holds this one"/>
      <!-- U178: the folder's exclusion sits right after its path; a long
           path is trimmed first, so the button always stays in view. -->
      <DockPanel Grid.Column="2" HorizontalAlignment="Left" Margin="0,0,16,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Name="ExcludeFolder" Classes="ghost" Content="Exclude this folder" Command="{Binding ExcludeFolderCommand}"
                  IsVisible="{Binding CanExclude}" IsEnabled="{Binding !IsConfirmingExclude}"
                  ToolTip.Tip="Leave this folder out of this backup's next runs"/>
          <TextBlock Name="ExcludedNote" Text="Excluded from the next backup" VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource BS.Brush.BandOkFg}" IsVisible="{Binding IsExcluded}"
                     ToolTip.Tip="{Binding ExcludeRule}"/>
          <Button Name="UndoExclude" Classes="ghost" Content="Undo" Command="{Binding UndoExcludeCommand}" IsVisible="{Binding IsExcluded}"
                  ToolTip.Tip="Take the rule out again: the next backup includes this folder"/>
          <TextBlock Name="AlreadyExcludedNote" Classes="dim" Text="Already excluded from the next backup" VerticalAlignment="Center"
                     IsVisible="{Binding IsAlreadyExcluded}" ToolTip.Tip="{Binding AlreadyExcludedBy, StringFormat='By the rule {0}'}"/>
        </StackPanel>
        <TextBlock Name="MapLocation" Classes="mono" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding Location}" ToolTip.Tip="{Binding TopFolder}"/>
      </DockPanel>
      <TextBlock Grid.Column="3" Name="ChangeSummary" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Summary}"/>
    </Grid>

    <!-- U178: the confirmation, with the exact rule it adds. -->
    <Border Grid.Row="2" Name="ExcludeConfirmation" Classes="callout" Padding="16,12" Margin="0,0,0,12"
            IsVisible="{Binding IsConfirmingExclude}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding ExcludeQuestion}" Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
          <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding ExcludeRuleIntro}" Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
          <SelectableTextBlock Name="ExcludeRuleText" FontFamily="{DynamicResource BS.Font.Mono}" FontSize="13" TextWrapping="Wrap" Text="{Binding ExcludeRule}"
                               Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
          <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding ExcludeOnDisk}" IsVisible="{Binding HasExcludeOnDisk}"
                     Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
          <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgPrimary}"
                     Text="Backups already made keep it: you can still restore it from them."/>
          <TextBlock Name="ExcludeWarning" FontSize="13" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ExcludeWarning}"
                     IsVisible="{Binding HasExcludeWarning}" Foreground="{DynamicResource BS.Brush.BandWarnFg}"/>
          <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding ExcludeError}" IsVisible="{Binding HasExcludeError}"
                     Foreground="{DynamicResource BS.Brush.BandFailFg}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="16,0,0,0">
          <Button Classes="ghost" Content="Cancel" Command="{Binding CancelExcludeCommand}"/>
          <Button Name="ConfirmExclude" Classes="primary" Content="Exclude from next backups" Command="{Binding ConfirmExcludeCommand}"
                  IsEnabled="{Binding CanConfirmExclude}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,16,320">
      <Border Classes="surface" Padding="6">
        <Panel>
          <v:ChangeTreemap Name="Map" Node="{Binding Current}"/>
          <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <ProgressBar IsIndeterminate="True" Width="220"/>
            <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>
        </Panel>
      </Border>
      <Border Grid.Column="2" Classes="surface" Padding="14,12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="label-caps" Text="LARGEST FILES" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="Largest" ItemsSource="{Binding LargestFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ChangedFileRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,6,8" ToolTip.Tip="{Binding Folder}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="13"/>
                      <TextBlock Text="{Binding Folder}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Size}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding Change}" Classes="dim" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="4" Name="HoverInfo" Margin="0,10,0,0" Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis"
               Text="{Binding HoverText}"/>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Name="StatusNote" Text="{Binding Status}" IsVisible="{Binding !IsLoading}" TextWrapping="Wrap" FontSize="13"/>
        <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                   Text="Each box is a folder or file, sized by the bytes of the files this backup added or changed. Click a folder to open it. Sizes are of the files; the storage received less when parts were already stored."/>
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost" Content="Close" Click="OnClose" VerticalAlignment="Bottom" Margin="16,0,0,0"/>
    </Grid>
  </Grid>
</Window>
