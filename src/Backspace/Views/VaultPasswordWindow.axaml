<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Backspace.Views.VaultPasswordWindow"
        Title="Saved passwords - Backspace"
        Width="560" SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource BS.Brush.BgBase}"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="34,30,34,26" Spacing="18">
    <StackPanel Spacing="6">
      <TextBlock x:Name="TitleBlock" Classes="card-title" TextWrapping="Wrap"/>
      <TextBlock x:Name="ReasonBlock" Classes="body" TextWrapping="Wrap" FontWeight="SemiBold"
                 Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
      <TextBlock x:Name="IntroBlock" Classes="body" TextWrapping="Wrap"
                 Foreground="{DynamicResource BS.Brush.FgSecondary}"/>
    </StackPanel>

    <Border Classes="rule"/>

    <StackPanel Spacing="6">
      <TextBlock x:Name="PasswordLabel" Classes="label-caps" Text="PASSWORD"/>
      <TextBox x:Name="PasswordBox" PasswordChar="•"/>
    </StackPanel>
    <StackPanel Spacing="6" x:Name="ConfirmPanel">
      <TextBlock Classes="label-caps" Text="TYPE IT AGAIN"/>
      <TextBox x:Name="ConfirmBox" PasswordChar="•"/>
    </StackPanel>

    <!-- Shown while both boxes are empty in the modes that allow it: an
         empty password only obscures the saved passwords. -->
    <Border Classes="notice warn" x:Name="NoPasswordNotice" IsVisible="False" Padding="14,10">
      <TextBlock x:Name="NoPasswordText" Classes="body" TextWrapping="Wrap"/>
    </Border>

    <Border Classes="validation-summary" x:Name="ErrorBanner" IsVisible="False">
      <Grid ColumnDefinitions="Auto,10,*">
        <TextBlock Grid.Column="0" Text="!" FontSize="18" FontWeight="Bold" VerticalAlignment="Top"
                   Foreground="{DynamicResource BS.Brush.DangerTintFg}"/>
        <TextBlock Grid.Column="2" x:Name="ErrorText"
                   Classes="body" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource BS.Brush.DangerTintFg}"/>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="Auto,10,*" x:Name="StatusRow" IsVisible="False">
      <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"
                   Foreground="{DynamicResource BS.Brush.Accent}" Background="{DynamicResource BS.Brush.AccentTint}"/>
      <TextBlock Grid.Column="2" x:Name="StatusInfo" Classes="dim" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="ghost" x:Name="CancelButton" Content="Not now" Click="OnCancel"/>
      <Button Classes="primary" x:Name="ConfirmButton" Content="Save" Click="OnConfirm"/>
    </StackPanel>
  </StackPanel>
</Window>
