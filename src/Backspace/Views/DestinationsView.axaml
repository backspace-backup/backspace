<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Backspace.ViewModels"
             x:Class="Backspace.Views.DestinationsView"
             x:DataType="vm:DestinationsViewModel"
             Background="{DynamicResource BS.Brush.BgBase}">

  <ScrollViewer>
    <StackPanel Margin="32,4,32,32">

      <!-- Same compact header as Your backups (U030, 29 October 2026). The
           main action spans title and subtitle; the text wraps a short gap
           before it rather than running underneath (U040). -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="page-title" Text="Where backups live"/>
            <Border Classes="count-badge" IsVisible="{Binding !IsEmpty}"
                    ToolTip.Tip="Number of destinations">
              <TextBlock Text="{Binding Rows.Count}"/>
            </Border>
          </StackPanel>
          <TextBlock Classes="page-subtitle"
                     Text="Places your backups are stored: an external drive, a cloud account or a network share. One backup can use several."/>
        </StackPanel>
        <Button Grid.Column="1" Classes="primary header-action"
                IsVisible="{Binding !IsEmpty}" Command="{Binding AddNewCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Foreground="White"/>
            <TextBlock Text="Add a destination" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- List only when we have rows. Empty state below owns the primary
           CTA so there's exactly one obvious next step. -->
      <StackPanel IsVisible="{Binding !IsEmpty}" Margin="0,16,0,0">
        <!-- Container border + per-row separators. Strategy: the
             container draws full border + corner radius. Each row
             paints ONLY its content (no per-row borders). Separators
             between rows are rendered as 1-pixel-tall Border lines
             that live at the TOP of every row except the first. We
             scope visibility via a `nth-child(n+2)` selector so only
             rows 2..N show their separator — Avalonia 11's CSS-style
             selector matches reliably this way (the prior
             `:nth-child(1) > Border` shape didn't always pick up the
             ContentPresenter wrapping in the items panel, so the
             first row's separator could leak through and read as a
             double border at the top of the list). -->
        <Border Background="{DynamicResource BS.Brush.BgSurface}"
                BorderBrush="{DynamicResource BS.Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource BS.CornerRadius}"
                ClipToBounds="True">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.Styles>
              <!-- Show the top hairline separator on rows 2..N.
                   `nth-child(n+2)` matches every ContentPresenter
                   from index 2 onwards (1-based). The Border tagged
                   `dest-row-sep` is a 1px line laid out as the first
                   visible child of the row template; default
                   BorderThickness is 0 so the first row stays clean. -->
              <Style Selector="ContentPresenter:nth-child(n+2) Border.dest-row-sep">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource BS.Brush.BorderSubtle}"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DestinationRow">
                <StackPanel>
                  <Border Classes="dest-row-sep"/>
                  <Border Padding="20,16">
                  <Grid ColumnDefinitions="44,*,Auto,Auto" VerticalAlignment="Center">

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                            Background="{DynamicResource BS.Brush.AccentTint}"
                            HorizontalAlignment="Left">
                      <PathIcon Data="{Binding KindGlyph, Converter={x:Static vm:ResourceLookup.To}}"
                                Width="18" Height="18"
                                Foreground="{DynamicResource BS.Brush.Accent}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" Margin="14,0,0,0">
                      <TextBlock Text="{Binding Name}" Classes="row-title"/>
                      <!-- Grid so the URL's ellipsis tracks the actual
                           remaining width at every window size instead
                           of a hard MaxWidth cap that could overflow
                           the row into the Edit/Delete buttons. -->
                      <Grid ColumnDefinitions="Auto,10,Auto,10,*">
                        <TextBlock Grid.Column="0" Text="{Binding Kind}" Classes="dim"/>
                        <TextBlock Grid.Column="2" Text="·" Foreground="{DynamicResource BS.Brush.FgDim}"/>
                        <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Url}"
                                   HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Url}"
                                   FontSize="12"/>
                      </Grid>
                    </StackPanel>

                    <Button Grid.Column="2" Classes="row-action"
                            Command="{Binding $parent[ItemsControl].((vm:DestinationsViewModel)DataContext).EditCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Edit}" Width="13" Height="13"/>
                        <TextBlock Text="Edit"/>
                      </StackPanel>
                    </Button>
                    <!-- Delete is destructive: it removes the destination
                         from Backspace AND erases the backup data
                         Backspace wrote there (the restic repository
                         layout: data/, index/, keys/, snapshots/,
                         config). The user is asked to type-confirm before
                         the wipe, then a modal progress dialog runs the
                         cleanup so they can't quit the app mid-wipe. The
                         tooltip says so explicitly — without it, "Delete"
                         reads like a config-only remove and users have
                         been surprised to see their cloud-storage data
                         gone. -->
                    <Button Grid.Column="3" Classes="row-action-danger" Margin="6,0,0,0"
                            ToolTip.Tip="Removes this destination from Backspace AND erases the backup data stored there. Foreign data on the same folder is left alone. You'll be asked to type-confirm before anything is deleted."
                            Command="{Binding $parent[ItemsControl].((vm:DestinationsViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Trash}" Width="13" Height="13"/>
                        <TextBlock Text="Delete"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- Empty state: CTA lives inside the card so the eye lands on it. -->
      <Border IsVisible="{Binding IsEmpty}" Classes="empty-state" Margin="0,28,0,0">
        <Grid ColumnDefinitions="Auto,20,*">
          <Border Grid.Column="0" Classes="empty-state-glyph">
            <PathIcon Data="{StaticResource Icon.Cloud}"/>
          </Border>
          <StackPanel Grid.Column="2" Spacing="16">
            <TextBlock Classes="card-title" Text="Add your first destination"/>
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="Pick whatever makes sense for you: an external drive, a cloud folder you're already paying for, a network share at home, or an S3-compatible bucket. Backspace takes care of signing in."/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
              <Button Classes="primary" Command="{Binding AddNewCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Foreground="White"/>
                  <TextBlock Text="Add a destination" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
