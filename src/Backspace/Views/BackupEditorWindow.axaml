<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Backspace.ViewModels"
        xmlns:m="using:Backspace.Models"
        xmlns:v="using:Backspace.Views"
        x:Class="Backspace.Views.BackupEditorWindow"
        x:DataType="vm:BackupEditorViewModel"
        Title="Backup settings - Backspace"
        Width="980" Height="840"
        MinWidth="820" MinHeight="500"
        Background="{DynamicResource BS.Brush.BgBase}"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- U150 (5 November 2026): Fluent's tab headers are 24 px with a
         48 px strip, which made this window's tabs the largest text on
         screen. Headers are now the size of the main window's section
         titles, sub-tabs a step smaller, and cards a little tighter. -->
    <Style Selector="TabControl.editor-tabs > TabItem">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="Margin" Value="0,0,24,0"/>
    </Style>
    <Style Selector="TabControl.sub > TabItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="Margin" Value="0,0,20,0"/>
    </Style>
    <Style Selector="TabControl.sub > TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Padding" Value="20,16"/>
    </Style>
    <Style Selector="RadioButton.check-choice">
      <Setter Property="Padding" Value="10,0,0,0"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style Selector="RadioButton.check-choice:checked">
      <Setter Property="Foreground" Value="{DynamicResource BS.Brush.AccentTintFg}"/>
    </Style>
    <Style Selector="Border.check-row">
      <Setter Property="Background" Value="{DynamicResource BS.Brush.BgSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BS.Brush.BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style Selector="Border.check-row.selected">
      <Setter Property="Background" Value="{DynamicResource BS.Brush.AccentTint}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BS.Brush.Accent}"/>
    </Style>
    <Style Selector="RadioButton.check-choice TextBlock.helper">
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- A recommended group's state beside its checkbox (U165 follow-up):
         green "In place", amber "Will be … when you save", or a quiet "Not used". -->
    <DataTemplate x:Key="GroupStatusPill" x:DataType="vm:RecommendedGroupState">
      <Panel>
        <Border IsVisible="{Binding IsInPlace}" CornerRadius="999" Padding="10,3"
                Background="{DynamicResource BS.Brush.SuccessTint}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" VerticalAlignment="Center"
                      Foreground="{DynamicResource BS.Brush.SuccessTintFg}"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource BS.Brush.SuccessTintFg}"/>
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding IsPending}" CornerRadius="999" Padding="10,3"
                Background="{DynamicResource BS.Brush.WarnTint}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource BS.Brush.Warn}"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource BS.Brush.WarnTintFg}"/>
          </StackPanel>
        </Border>
        <TextBlock IsVisible="{Binding IsNotUsed}" Text="{Binding StatusText}" FontSize="12" Margin="10,3"
                   Foreground="{DynamicResource BS.Brush.FgDim}"/>
      </Panel>
    </DataTemplate>
    <!-- Under the checkbox: the group's rules, collapsed, or why it has none here. -->
    <DataTemplate x:Key="GroupRules" x:DataType="vm:RecommendedGroupState">
      <StackPanel Spacing="2">
        <Expander Classes="advanced" Header="{Binding RulesHeader}" IsVisible="{Binding HasRules}">
          <SelectableTextBlock FontFamily="{DynamicResource BS.Font.Mono}" FontSize="12" LineHeight="18" Text="{Binding RulesText}"
                               Foreground="{DynamicResource BS.Brush.FgSecondary}" TextWrapping="Wrap"/>
        </Expander>
        <TextBlock IsVisible="{Binding !HasRules}" Text="{Binding NoRulesText}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource BS.Brush.FgDim}"/>
        <TextBlock IsVisible="{Binding HasPending}" Text="{Binding PendingText}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource BS.Brush.Accent}"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="28,20,28,18">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Classes="page-title" Text="{Binding HeaderTitle}"/>
        <TextBlock Classes="page-subtitle" MaxWidth="720"
                   Text="You can refine anything later and switch easy/advanced mode at any time."/>
      </StackPanel>
      <!-- Mode toggle — see OnboardingWindow for the toggle-segment
           rationale. Same control type both sides so both render at
           the same height; only the active sub-class changes fill. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal"
                  Height="32"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Editor mode"
                  AutomationProperties.HelpText="Two-segment toggle: Easy or Advanced.">
        <Button Classes="toggle-segment toggle-segment-left"
                Content="Easy"
                Click="OnSwitchToEasy"
                AutomationProperties.Name="Easy mode"
                AutomationProperties.HelpText="Switch to Easy mode (hides advanced options)."/>
        <!-- Focusable + IsTabStop so screen readers reach the active
             segment for its "Currently selected" announcement.
             See OnboardingWindow.axaml for the same pattern. -->
        <Button Classes="toggle-segment toggle-segment-active toggle-segment-right"
                Content="Advanced"
                IsHitTestVisible="False"
                Focusable="True"
                IsTabStop="True"
                AutomationProperties.Name="Advanced mode"
                AutomationProperties.HelpText="Currently selected. Advanced mode shows every option."/>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" Classes="editor-tabs" Background="Transparent" BorderThickness="0" Padding="0" Name="EditorTabs">

      <!-- =========== TAB: Overview =========== -->
      <TabItem Header="Overview" FontFamily="{DynamicResource BS.Font.Body}">
        <!-- ScrollViewer without Padding — earlier attempts used Padding
             to breathe around the content but that appears to decouple the
             viewport from the Extent on real Windows, so the last section
             sat past Extent.Height and couldn't be scrolled into view.
             Spacing now lives as Margin on the inner StackPanel. -->
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="0,10,0,0">

            <!-- (Validation summary moved to the footer, just above
                 Cancel/Save, so it's always visible regardless of how
                 far the user has scrolled.) -->

            <!-- Card: FRIENDLY NAME. Compact card at the top so the
                 user can rename a backup without scrolling. The helper
                 line is short on purpose — the surrounding form is
                 already long; the snapshot-chain-rename-safety contract
                 lives in the docs. -->
            <Border Classes="surface">
              <StackPanel Spacing="6">
                <TextBlock Classes="section-title" Text="Friendly name" Margin="0"/>
                <TextBox Text="{Binding Name}"
                         PlaceholderText="{Binding SuggestedName}"
                         Classes.error="{Binding NameError, Converter={x:Static vm:NotEmpty.To}}"/>
                <TextBlock Classes="helper" Margin="0"
                           Text="Only changes the name shown in Backspace. What’s already backed up is not affected."/>
                <TextBlock Classes="field-error" Text="{Binding NameError}"
                           IsVisible="{Binding NameError, Converter={x:Static vm:NotEmpty.To}}"/>
              </StackPanel>
            </Border>

            <!-- Card: SOURCES (primary — this is what the user is actually
                 configuring; the name is a convenience fallback shoved
                 into Options). -->
            <Border Classes="surface">
              <StackPanel Spacing="14">
                <TextBlock Classes="section-title" Text="Sources" Margin="0"/>

                <TextBlock Classes="helper" Margin="0"
                           Text="Pick the folders you want kept safe. Each folder gets its own snapshot chain, so you can restore any of them independently."/>

                <!-- Empty-state: the whole purpose of this card when the
                     user hasn't picked a source yet. -->
                <TextBlock Classes="field-error" FontSize="13"
                           Text="{Binding SourcesError}"
                           IsVisible="{Binding SourcesError, Converter={x:Static vm:NotEmpty.To}}"/>

                <ItemsControl ItemsSource="{Binding SourceChips}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SourceChipVm">
                      <Border Background="{DynamicResource BS.Brush.AccentTint}"
                              CornerRadius="8"
                              Padding="12,8,8,8"
                              Margin="0,0,0,6">
                        <Grid ColumnDefinitions="Auto,10,*,Auto" VerticalAlignment="Center">
                          <PathIcon Grid.Column="0" Data="{StaticResource Icon.Folder}"
                                    Width="14" Height="14"
                                    Foreground="{DynamicResource BS.Brush.Accent}"
                                    VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Classes="mono" FontSize="13"
                                       Text="{Binding Path}"
                                       Foreground="{DynamicResource BS.Brush.FgPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                       Text="{Binding SizeLabel}" ToolTip.Tip="{Binding SizeTooltip}"/>
                          </StackPanel>
                          <Button Grid.Column="3" Classes="row-action-danger"
                                  Command="{Binding $parent[ItemsControl].((vm:BackupEditorViewModel)DataContext).RemoveSourceCommand}"
                                  CommandParameter="{Binding Path}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Data="{StaticResource Icon.Trash}" Width="12" Height="12"/>
                              <TextBlock Text="Remove"/>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="primary"
                          Command="{Binding AddSourceFromTreeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Foreground="White"/>
                      <TextBlock Text="Add sources…" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost"
                          Command="{Binding AddSourceByPathCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="14" Height="14"/>
                      <TextBlock Text="Add single folder…" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Card: targets -->
            <Border Classes="surface">
              <StackPanel Spacing="14">
                <TextBlock Classes="section-title" Text="Destinations" Margin="0"/>
                <TextBlock Classes="field-error" FontSize="13"
                           Text="{Binding TargetsError}"
                           IsVisible="{Binding TargetsError, Converter={x:Static vm:NotEmpty.To}}"/>
                <!-- Each target rendered as a light-blue chip — same
                     pattern as Easy mode + Sources. Info on the LEFT
                     (icon + name + storage), action buttons on the
                     RIGHT (Prune / Remove / Erase). The previous
                     two-line layout (info top, buttons bottom-left)
                     read as cluttered and "Prune to latest" lost its
                     button styling against the chip background. -->
                <ItemsControl ItemsSource="{Binding Targets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TargetRow">
                      <Border Background="{DynamicResource BS.Brush.AccentTint}"
                              CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,10,*,Auto" VerticalAlignment="Center">
                          <PathIcon Grid.Column="0"
                                    Data="{Binding DestinationKind, Converter={x:Static vm:DestinationKindIcon.To}}"
                                    Width="14" Height="14"
                                    Foreground="{DynamicResource BS.Brush.Accent}"
                                    VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DestinationName}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
                            <TextBlock Classes="dim" FontSize="11"
                                       Text="{Binding StorageName, StringFormat='storage: {0}'}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                      VerticalAlignment="Center">
                            <!-- Edit (constructive) precedes the
                                 destructive cluster, matching the
                                 BackupCard pattern. Each button now
                                 carries a glyph: pencil = edit,
                                 scissors = prune (trim history),
                                 flame = erase (burn ALL data) and
                                 trash = remove (forget destination
                                 here, data stays remote). Glyphs
                                 differentiate Erase from Remove at a
                                 glance — both are red-toned, but the
                                 flame signals categorically more
                                 destructive than the trash. -->
                            <Button Classes="row-action"
                                    ToolTip.Tip="Edit this destination's settings"
                                    Command="{Binding $parent[ItemsControl].((vm:BackupEditorViewModel)DataContext).EditTargetDestinationCommand}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Icon.Edit}" Width="12" Height="12"/>
                                <TextBlock Text="Edit"/>
                              </StackPanel>
                            </Button>
                            <Button Classes="row-action-warn"
                                    ToolTip.Tip="Delete older revisions to reclaim space (latest revision is preserved)"
                                    Command="{Binding $parent[ItemsControl].((vm:BackupEditorViewModel)DataContext).PruneToLatestCommand}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Icon.Compress}" Width="12" Height="12"/>
                                <TextBlock Text="Prune"/>
                              </StackPanel>
                            </Button>
                            <!-- Erase uses row-action-critical (Mantine
                                 filled red) instead of row-action-danger
                                 so it's visually heavier than Remove —
                                 the user asked for "a colour stronger
                                 than red" to flag this is even more
                                 destructive. Both buttons still red,
                                 but solid-filled vs light-tonal makes
                                 the severity hierarchy obvious. -->
                            <Button Classes="row-action-critical"
                                    ToolTip.Tip="Wipe ALL data this backup has stored at this destination"
                                    Command="{Binding $parent[ItemsControl].((vm:BackupEditorViewModel)DataContext).EraseDestinationCommand}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Icon.Eraser}" Width="12" Height="12"/>
                                <TextBlock Text="Erase"/>
                              </StackPanel>
                            </Button>
                            <Button Classes="row-action-danger"
                                    ToolTip.Tip="Stop using this destination for this backup (data on remote stays)"
                                    Command="{Binding $parent[ItemsControl].((vm:BackupEditorViewModel)DataContext).RemoveTargetCommand}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Icon.Trash}" Width="12" Height="12"/>
                                <TextBlock Text="Remove"/>
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- If no destinations are configured yet, show a
                     contextual "Set one up" callout instead of an empty
                     picker. Opens DestinationEditor modally; the newly
                     saved destination is pre-selected on return. -->
                <Border Classes="callout" IsVisible="{Binding HasNoAvailableDestinations}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="body" FontWeight="SemiBold"
                               Text="No destinations set up yet"
                               Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
                    <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                               Text="Destinations are where your backups live: a drive, a cloud folder, or an S3 bucket. Add one now and it'll be available across all your backups."/>
                    <Button Classes="primary" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Command="{Binding CreateDestinationInlineCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Foreground="White"/>
                        <TextBlock Text="Set up a destination" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>

                <!-- SHARED component — identical to OnboardingWindow's
                     Easy-mode picker. The Add button's "disabled when
                     nothing's picked" gate lives inside the control,
                     so Easy and Advanced modes can't drift apart
                     (which is what happened before — Advanced kept
                     the Add button enabled with no selection while
                     Easy correctly disabled it). -->
                <v:DestinationAddPicker
                    IsVisible="{Binding !HasNoAvailableDestinations}"
                    AvailableDestinations="{Binding AvailableDestinationsForAdd}"
                    SelectedDestination="{Binding PendingNewDestination, Mode=TwoWay}"
                    HasMoreToAdd="{Binding HasMoreDestinationsToAdd}"
                    AddCommand="{Binding AddTargetCommand}"
                    CreateNewCommand="{Binding CreateDestinationInlineCommand}"
                    CreateNewLabel="{Binding CreateDestinationButtonLabel}"/>
              </StackPanel>
            </Border>

            <!-- Card: Options. Retention policy goes first per user
                 feedback — it's the most decision-heavy knob; everything
                 else is optional tuning. Prune/Check are close kin of
                 retention. Threads, bandwidth, VSS and healthchecks
                 live in a toggle-able Advanced group below. -->
            <Border Classes="surface">
              <StackPanel Spacing="16">
                <TextBlock Classes="section-title" Text="Options" Margin="0"/>

                <!-- Retention policy (renamed from "Keep policy" per user
                     direction — "retention" is the term non-technical
                     users recognize). -->
                <StackPanel Spacing="6">
                  <TextBlock Classes="label-caps" Text="RETENTION POLICY"/>
                  <TextBlock Classes="helper" Margin="0,0,0,2"
                             Text="Space-separated n:m pairs: for backups older than m days, keep one every n days; n = 0 deletes them. Newer backups are all kept. A single number keeps that many latest backups."/>
                  <TextBox Text="{Binding KeepPolicy, UpdateSourceTrigger=PropertyChanged}"
                           FontFamily="{DynamicResource BS.Font.Mono}"
                           PlaceholderText="0:365 30:90 7:30 1:7"
                           Classes.error="{Binding KeepPolicyError, Converter={x:Static vm:NotEmpty.To}}"/>

                  <Border Padding="12,10" CornerRadius="8"
                          Background="{DynamicResource BS.Brush.AccentTint}"
                          IsVisible="{Binding KeepPolicyExplanation.Valid}">
                    <TextBlock Classes="body" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource BS.Brush.FgPrimary}"
                               Text="{Binding KeepPolicyExplanation.Summary}"/>
                  </Border>
                  <Border Padding="12,10" CornerRadius="8"
                          Background="{DynamicResource BS.Brush.DangerTint}"
                          IsVisible="{Binding !KeepPolicyExplanation.Valid}">
                    <TextBlock Classes="body" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource BS.Brush.DangerTintFg}"
                               Text="{Binding KeepPolicyExplanation.Summary}"/>
                  </Border>
                </StackPanel>

                <!-- Prune-after-each-backup + Check-after-each-backup
                     toggles moved into the Schedule tab as part of
                     the Pruning Policy / Check Policy cadence combos
                     (one of which is "After each backup"). Keeping
                     them here too would let the user set conflicting
                     state. -->
              </StackPanel>
            </Border>

            <!-- Advanced reveal — lifted OUT of the Options card so the
                 toggle row is a sibling of the card Border rather than a
                 nested grandchild inside surface padding + StackPanel
                 spacing. That flatter tree measures reliably; earlier
                 nested placements caused the ScrollViewer's measured
                 content extent to stop short of the toggle on real
                 Windows (though not in the headless test harness),
                 making Advanced literally unreachable by scrolling. -->
            <Button Classes="advanced-toggle-btn" x:Name="AdvancedToggleButton"
                    HorizontalAlignment="Left"
                    Command="{Binding ToggleAdvancedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding AdvancedToggleLabel}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BS.Brush.Accent}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="(threads, bandwidth, VSS, healthchecks)"
                           Classes="dim" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- Advanced content: its own top-level card when open, so it
                 reads as a distinct section rather than a continuation of
                 Options. Hidden when the toggle is closed. -->
            <Border Classes="surface" IsVisible="{Binding IsAdvancedOpen}">
              <StackPanel Spacing="16">

                <!-- Friendly name now lives in the top-of-form card,
                     before Sources. Threads / bandwidth / VSS remain
                     Advanced-only. -->

                <Grid ColumnDefinitions="*,22,*,22,*">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="label-caps" Text="THREADS"/>
                    <NumericUpDown Value="{Binding Threads}" Minimum="0" Maximum="32"/>
                    <TextBlock Classes="helper"
                               Text="Leave at 0 for auto: we pick 1 for local / NAS destinations and 4 for cloud. Any positive value overrides the auto choice for every destination."/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="label-caps" Text="BANDWIDTH LIMIT (KB/S)"/>
                    <NumericUpDown Value="{Binding BandwidthLimitKBps}" Minimum="0" Maximum="1000000"/>
                    <TextBlock Classes="helper" Text="0 = unlimited"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="6">
                    <TextBlock Classes="label-caps" Text="WINDOWS BEHAVIOR"/>
                    <CheckBox Name="UseVssCheck" IsChecked="{Binding UseVss}"
                              Content="Use Windows snapshots (VSS)"
                              Foreground="{DynamicResource BS.Brush.FgPrimary}">
                      <ToolTip.Tip>
                        <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                   Text="Recommended. Read files from a consistent Windows snapshot, including files held open by other apps. Windows asks for administrator permission when needed. NAS folders and some filesystems do not support snapshots."/>
                      </ToolTip.Tip>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ExcludeCloudFiles}"
                              Content="Skip cloud-only placeholders"
                              Foreground="{DynamicResource BS.Brush.FgPrimary}">
                      <ToolTip.Tip>
                        <StackPanel MaxWidth="380" Spacing="6">
                          <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                     Text="Skip OneDrive / Dropbox / iCloud files that are online-only (not downloaded to this PC)."/>
                          <TextBlock TextWrapping="Wrap"
                                     Text="Turning this off makes Backspace read online-only files during backup. Your cloud provider may download them and keep them on this computer. Backing up 200 GB of online-only files could therefore use 200 GB of extra disk space until you make those files online-only again."/>
                          <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                                     Text="To mirror a cloud account to another destination without cluttering local disk, use an rclone-backed source instead (coming in a later release)."/>
                        </StackPanel>
                      </ToolTip.Tip>
                    </CheckBox>
                  </StackPanel>
                </Grid>

                <Border IsVisible="{Binding ShowVssWarning}" Background="{DynamicResource BS.Brush.WarnTint}"
                        BorderBrush="{DynamicResource BS.Brush.Warn}" BorderThickness="1" CornerRadius="8" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="Open or locked files may be missing from this backup" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Text="Windows snapshots are off. Files in use may be skipped, and files changing during the backup may not form a consistent copy. Keep snapshots on whenever the source supports them. If Windows denies permission, approve its administrator prompt or ask your administrator for access."/>
                    <CheckBox Name="VssLimitationAcknowledgement" IsChecked="{Binding VssDisabledAcknowledged}">
                      <TextBlock TextWrapping="Wrap" Text="I cannot use Windows snapshots for this backup and accept these limitations."/>
                    </CheckBox>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="6">
                  <TextBlock Classes="label-caps" Text="HEALTHCHECKS.IO"/>

                  <!-- Inline setup: shown only when the global API key
                       isn't already set in Settings. Saving the backup
                       writes whatever is here back into Settings, so
                       this acts as an in-flow shortcut for first-time
                       users without forcing them to bounce out. -->
                  <StackPanel Spacing="6" IsVisible="{Binding NeedsHealthcheckSetup}">
                    <TextBlock Classes="helper" Margin="0,0,0,2"
                               Text="Heads up: you don't have a Healthchecks.io API key in Settings yet. Paste one here and we'll save it for you (or visit Settings to set it up first)."/>
                    <Grid ColumnDefinitions="*,16,260">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label-caps" Text="API KEY"/>
                        <!-- Accept provider-issued keys without assuming a
                             particular prefix or length. -->
                        <TextBox Text="{Binding HealthcheckApiKeyInput}" PasswordChar="•"
                                 PlaceholderText="Project key from Healthchecks → Settings → API Access">
                          <ToolTip.Tip>
                            <StackPanel MaxWidth="400" Spacing="6">
                              <TextBlock FontWeight="SemiBold" Text="How to get your Healthchecks.io API key"/>
                              <TextBlock TextWrapping="Wrap"
                                         Text="1.  Sign in (or sign up) at healthchecks.io."/>
                              <TextBlock TextWrapping="Wrap"
                                         Text="2.  Open your project (the default project that gets created on signup is fine)."/>
                              <TextBlock TextWrapping="Wrap"
                                         Text="3.  Click the project's &quot;Settings&quot; link at the top."/>
                              <TextBlock TextWrapping="Wrap"
                                         Text="4.  Find the &quot;API Access&quot; section and click &quot;Create&quot; next to API key."/>
                              <TextBlock TextWrapping="Wrap"
                                         Text="5.  Copy the regular &quot;API key&quot; (NOT read-only; we need write access to create the check for this backup)."/>
                            </StackPanel>
                          </ToolTip.Tip>
                        </TextBox>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="label-caps" Text="BASE URL"/>
                        <TextBox Text="{Binding HealthcheckBaseUrlInput}"
                                 PlaceholderText="https://healthchecks.io"
                                 ToolTip.Tip="Only change this if you self-host Healthchecks."/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <Grid ColumnDefinitions="Auto,12,*">
                    <Button Grid.Column="0" Classes="ghost" Content="Create / update check"
                            Command="{Binding CreateHealthcheckCommand}"/>
                    <TextBox Grid.Column="2" Text="{Binding HealthcheckId}"
                             FontFamily="{DynamicResource BS.Font.Mono}"
                             PlaceholderText="UUID from healthchecks.io (auto-filled after create)"
                             Classes.error="{Binding HealthcheckIdError, Converter={x:Static vm:NotEmpty.To}}"/>
                  </Grid>
                  <TextBlock Classes="field-error" Text="{Binding HealthcheckIdError}"
                             IsVisible="{Binding HealthcheckIdError, Converter={x:Static vm:NotEmpty.To}}"/>
                  <TextBlock Classes="dim" Text="{Binding HealthcheckStatus}"
                             IsVisible="{Binding HealthcheckStatus, Converter={x:Static vm:NotEmpty.To}}"/>
                </StackPanel>

                <!--
                  No free-text engine arguments box: per-backup tuning is
                  surfaced as its own controls. The background service
                  runs every backup as Windows itself, so settings never
                  carry arbitrary engine arguments (U171).
                -->

              </StackPanel>
            </Border>

            <!-- Trailing sentinel: a 40px invisible spacer forces the
                 ScrollViewer's measured Extent a clear step beyond the
                 last real card, so layout-measure rounding errors or
                 FluentTheme quirks can't leave the last item just outside
                 the scrollable range. Gives visual breathing room too. -->
            <Border Height="24" Background="Transparent"/>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- =========== TAB: Schedule =========== -->
      <TabItem Header="Schedule">
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="0,10,0,24">

            <Border Classes="surface">
              <StackPanel Spacing="16">

                <!-- Master switch: when off, the backup is configured but
                     never auto-runs. Lives at the top of the Schedule
                     tab where users naturally look for "should this run
                     automatically?" — earlier it was tucked into the
                     Sources card on the Overview tab and got missed.
                     Wrapped in master-toggle chrome to match the
                     Encrypt-storage gateway control in the destination
                     editor — same visual weight = same role. -->
                <Border Classes="master-toggle">
                  <CheckBox IsChecked="{Binding Enabled}"
                            Content="Run this backup automatically on the schedule below"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
                </Border>

                <Grid ColumnDefinitions="*,22,*"
                      IsEnabled="{Binding Enabled}">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="label-caps" Text="FREQUENCY"/>
                    <ComboBox ItemsSource="{Binding AvailableFrequencies}" SelectedItem="{Binding Frequency}"
                              HorizontalAlignment="Stretch"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="label-caps" Text="TIME OF DAY"/>
                    <TimePicker SelectedTime="{Binding TimeOfDay}" ClockIdentifier="24HourClock"/>
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="6"
                            IsEnabled="{Binding Enabled}"
                            IsVisible="{Binding Frequency, Converter={x:Static vm:Eq.To}, ConverterParameter=Hourly}">
                  <TextBlock Classes="label-caps" Text="RUN EVERY N HOURS"/>
                  <NumericUpDown Value="{Binding HourlyInterval}" Minimum="1" Maximum="168"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="surface">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Conditions" Margin="0"/>

                <!-- Start / skip conditions first — these decide
                     whether the run starts at all. -->
                <CheckBox IsChecked="{Binding SkipOnBattery}"      Content="Skip runs when on battery"
                          Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
                <CheckBox IsChecked="{Binding RequireNetwork}"     Content="Skip run if no internet connection"
                          Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
                <CheckBox IsChecked="{Binding CatchUpMissed}"      Content="Run missed scheduled backups as soon as possible"
                          Foreground="{DynamicResource BS.Brush.FgPrimary}"/>

                <!-- Stop conditions — what aborts a run that's already
                     in flight. Grouped at the bottom so the list reads
                     as "starting rules, then stopping rules". -->
                <Border Classes="rule" Margin="0,4"/>
                <CheckBox IsChecked="{Binding StopOnBattery}"      Content="Stop mid-run if the computer switches to battery"
                          Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
                <CheckBox IsChecked="{Binding AbortOnMeteredNetwork}" Content="Stop mid-run if the connection becomes metered"
                          Foreground="{DynamicResource BS.Brush.FgPrimary}"/>

                <!-- ===== Grace period for skipped runs =====
                     Always visible in Advanced mode so power users can
                     configure / reset regardless of current run state.
                     Easy mode also keeps these controls available
                     before an absence and after the window expires. -->
                <Border Classes="rule" Margin="0,4"/>
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource BS.Brush.FgPrimary}"
                           Text="Quiet skipped-run alerts for…"/>
                <Grid ColumnDefinitions="Auto,10,Auto,10,Auto" VerticalAlignment="Center">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding SkipNotificationGraceDays}"
                                 Minimum="0" Maximum="365"
                                 Width="110"/>
                  <TextBlock Grid.Column="2" Classes="dim" VerticalAlignment="Center"
                             Text="days after a successful backup"/>
                  <Button Grid.Column="4" Classes="ghost"
                          Command="{Binding ResetGracePeriodCommand}"
                          Content="Reset grace period"
                          ToolTip.Tip="Click before a known absence (e.g. going away for 2 weeks) to push the grace window forward without faking a backup success."/>
                </Grid>
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                           Text="{Binding GraceReferenceLabel}"/>
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                           Text="During the grace window, Skipped runs don't trigger notifications. After it expires, Skipped runs can send warning notifications. Their status stays Skipped. Set to 0 to disable the grace window entirely."/>
              </StackPanel>
            </Border>

            <!-- MAINTENANCE: cleanup, then the backup's checks (U179). Cleanup
                 keeps one cadence; checks are a list, one entry per check,
                 each with its own frequency, time and conditions. Entries
                 due together run one after another. -->
            <TextBlock Classes="section-title" Margin="0,4,0,0"
                       Text="Maintenance"/>

            <Border Classes="surface">
              <StackPanel Spacing="10">
                <TextBlock Classes="label-caps" Text="CLEANUP"/>
                <TextBlock Classes="helper" TextWrapping="Wrap"
                           Text="Removes old copies your retention policy no longer keeps and frees the space they used. After each backup suits small backups; weekly is better once cleanup takes longer than the backup itself."/>
                <!-- NOT gated on Enabled — maintenance can run on its
                     own schedule even when the user runs backups
                     manually rather than on the auto-schedule. -->
                <Grid ColumnDefinitions="*,22,*">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="label-caps" Text="HOW OFTEN"/>
                    <ComboBox Name="CleanupCadence" ItemsSource="{Binding AvailableMaintenanceCadences}"
                              SelectedItem="{Binding PruneCadence}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="m:MaintenanceCadence">
                          <TextBlock Text="{Binding ., Converter={x:Static vm:MaintenanceCadenceHumanizer.To}}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6"
                              IsVisible="{Binding PruneShowsTimeOfDay}">
                    <TextBlock Classes="label-caps" Text="TIME OF DAY"/>
                    <TimePicker SelectedTime="{Binding PruneTimeOfDay}" ClockIdentifier="24HourClock"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="surface" Name="ChecksCard">
              <StackPanel Spacing="12">
                <TextBlock Classes="label-caps" Text="CHECKS"/>
                <TextBlock Classes="helper" TextWrapping="Wrap"
                           Text="Each check below runs on its own schedule. Checks due at the same time run one after another, never together, and backups wait for them. Checks find problems; they do not repair a damaged backup."/>
                <Border Background="{DynamicResource BS.Brush.AccentTint}" CornerRadius="8" Padding="12,10">
                  <TextBlock Name="ChecksSentence" Text="{Binding ChecksSentence}" TextWrapping="Wrap"
                             Foreground="{DynamicResource BS.Brush.AccentTintFg}"/>
                </Border>
                <TextBlock Text="{Binding ChecksCompared}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource BS.Brush.FgSecondary}"/>
                <TextBlock Classes="dim" IsVisible="{Binding !HasChecks}" TextWrapping="Wrap"
                           Text="No checks. Nothing confirms that this backup can be restored until you add one."/>

                <ItemsControl Name="CheckList" ItemsSource="{Binding Checks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CheckEntryViewModel">
                      <Border Classes="check-row" Padding="14">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding When}" Classes="dim" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Content="Remove" VerticalAlignment="Top"
                                    Command="{Binding RemoveCommand}"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}"/>
                          </Grid>
                          <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="13"
                                     Foreground="{DynamicResource BS.Brush.FgSecondary}"/>
                          <WrapPanel>
                            <StackPanel Spacing="6" Width="190" Margin="0,0,16,8">
                              <TextBlock Classes="label-caps" Text="HOW OFTEN"/>
                              <ComboBox ItemsSource="{x:Static vm:CheckEntryViewModel.Cadences}" SelectedItem="{Binding Cadence}"
                                        HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate DataType="m:MaintenanceCadence">
                                    <TextBlock Text="{Binding ., Converter={x:Static vm:MaintenanceCadenceHumanizer.To}}"/>
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,16,8" IsVisible="{Binding ShowsTime}">
                              <TextBlock Classes="label-caps" Text="TIME OF DAY"/>
                              <TimePicker SelectedTime="{Binding TimeOfDay}" ClockIdentifier="24HourClock"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="150" Margin="0,0,16,8" IsVisible="{Binding IsTestRestore}">
                              <TextBlock Classes="label-caps" Text="SHARE OF FILES (%)"/>
                              <NumericUpDown Value="{Binding SamplePercent}" Minimum="0.01" Maximum="100" Increment="1" FormatString="0.##"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="150" Margin="0,0,16,8" IsVisible="{Binding !IsStructureOrFull}">
                              <TextBlock Classes="label-caps" Text="AT MOST (GiB)"/>
                              <NumericUpDown Value="{Binding MaximumGiB}" Minimum="0" Maximum="1048576" Increment="1" FormatString="0.##"/>
                            </StackPanel>
                          </WrapPanel>
                          <TextBlock Text="{Binding LimitHelp}" Classes="helper" TextWrapping="Wrap" IsVisible="{Binding !IsStructureOrFull}"/>
                          <CheckBox IsChecked="{Binding CompareOriginals}" IsVisible="{Binding IsTestRestore}">
                            <TextBlock Text="Also compare with today's originals (a difference can't tell which copy changed)" TextWrapping="Wrap"/>
                          </CheckBox>
                          <WrapPanel IsVisible="{Binding ShowsTime}">
                            <CheckBox IsChecked="{Binding SkipOnBattery}" Content="Skip on battery" Margin="0,0,18,0"/>
                            <CheckBox IsChecked="{Binding RequireNetwork}" Content="Wait for a network connection" Margin="0,0,18,0"/>
                            <CheckBox IsChecked="{Binding CatchUpMissed}" Content="Run a missed check later"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="label-caps" Text="ADD A CHECK" Margin="0,4,0,0"/>
                <WrapPanel>
                  <Button Name="AddStructureCheck" Classes="ghost" Content="+ Structure check" Margin="0,0,8,8"
                          Command="{Binding AddCheckCommand}" CommandParameter="{x:Static m:CheckKind.Structure}"
                          ToolTip.Tip="Checks the backup's records and that every piece of data is there. Quick; reads no file contents."/>
                  <Button Name="AddDataSample" Classes="ghost" Content="+ Data sample" Margin="0,0,8,8"
                          Command="{Binding AddCheckCommand}" CommandParameter="{x:Static m:CheckKind.DataSample}"
                          ToolTip.Tip="Downloads part of the stored data and checks it against its fingerprints."/>
                  <Button Name="AddTestRestore" Classes="ghost" Content="+ Sample test restore" Margin="0,0,8,8"
                          Command="{Binding AddCheckCommand}" CommandParameter="{x:Static m:CheckKind.TestRestore}"
                          ToolTip.Tip="Rebuilds a few real files from the latest backup."/>
                  <Button Name="AddFullDataRead" Classes="ghost" Content="+ Full data read" Margin="0,0,8,8"
                          Command="{Binding AddCheckCommand}" CommandParameter="{x:Static m:CheckKind.FullDataRead}"
                          IsEnabled="{Binding FullDataReadAvailable}"
                          ToolTip.Tip="{Binding FullDataReadHint}" ToolTip.ShowOnDisabled="True"/>
                </WrapPanel>
                <TextBlock Classes="helper" TextWrapping="Wrap" IsVisible="{Binding !FullDataReadAvailable}"
                           Text="Full data read is not available yet: this version of the backup engine can only read a sample."/>
              </StackPanel>
            </Border>

            <!-- Trailing sentinel: same pattern as the Backup tab —
                 a 40px invisible spacer guarantees the ScrollViewer's
                 measured extent reaches a step beyond the last
                 card. Without this the bottom of CHECK POLICY was
                 clipped on real Windows even when the user scrolled
                 to the maximum, because the surface's measured
                 extent stopped at the last card edge. -->
            <Border Height="24" Background="Transparent"/>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- =========== TAB: Filters ===========
           Split into two sub-tabs:
             • Recommended — curated checkboxes the typical user wants;
               sits inside a ScrollViewer so a too-small window shows
               a scrollbar instead of silently clipping the
               cloud-folder list at the bottom.
             • Advanced   — the rule text (Rules) and what it leaves out (Left out). Lives in
               its own sub-tab because it needs the full available
               vertical space for the text editor (the previous
               combined layout left the editor a sliver too short
               to read multi-page filter files comfortably).
           -->
      <TabItem Header="Filters" Name="FiltersTab">
        <TabControl Classes="sub" Margin="0,4,0,0" Padding="0" Name="FiltersSubTabs">
          <!-- Recommended sub-tab. -->
          <TabItem Header="Recommended" Name="RecommendedFiltersTab">
            <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0,8,0,8">
              <StackPanel Spacing="12">
                <!-- One line that says whether this page is what the backup
                     uses or waits for Save (U165 follow-up, 10 November 2026).
                     A tick changes the rules at once; Save, below, keeps them,
                     as on every other tab. There is no separate Apply. -->
                <Border Name="RecommendedSavedLine" CornerRadius="10" Padding="12,8"
                        Background="{DynamicResource BS.Brush.SuccessTint}" IsVisible="{Binding RecommendedSaved}">
                  <Grid ColumnDefinitions="Auto,8,*">
                    <PathIcon Data="{StaticResource Icon.Check}" Width="14" Height="14" VerticalAlignment="Center"
                              Foreground="{DynamicResource BS.Brush.SuccessTintFg}"/>
                    <TextBlock Grid.Column="2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource BS.Brush.FgPrimary}" Text="{Binding RecommendedStatus}"/>
                  </Grid>
                </Border>
                <Border Name="RecommendedUnsavedLine" CornerRadius="10" Padding="12,8"
                        Background="{DynamicResource BS.Brush.WarnTint}" IsVisible="{Binding FiltersUnsaved}">
                  <Grid ColumnDefinitions="Auto,8,*">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource BS.Brush.Warn}"/>
                    <TextBlock Grid.Column="2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource BS.Brush.FgPrimary}" Text="{Binding RecommendedStatus}"/>
                  </Grid>
                </Border>
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Name="RecommendedNewLine"
                           IsVisible="{Binding IsNew}" Text="{Binding RecommendedStatus}"/>

                <!-- Backspace's recommended lists changed since this backup's
                     rules were written (U057, U165). The card's "New filter
                     suggestions: Review" opens the editor here. Nothing changes
                     until the person accepts; unticked rows are hidden. -->
                <Border Classes="surface" Name="FilterSuggestions" IsVisible="{Binding HasRecommendationUpdate}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="New filter suggestions" Margin="0"/>
                    <TextBlock Classes="helper" Margin="0" TextWrapping="Wrap"
                               Text="Backspace's recommended exclusions changed since this backup's rules were written, or no longer fit its folders. Click Use ticked suggestions to put the ticked ones in this backup's rules; unticked ones are hidden for this backup, and ticking a group again doesn't bring them back. As with every change in this window, Save keeps it."/>
                    <StackPanel IsVisible="{Binding HasRecommendedAdditions}" Spacing="2">
                      <TextBlock Classes="label-caps" Text="{Binding RecommendedAdditions.Count, StringFormat='TO ADD ({0})'}"/>
                      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecommendedAdditions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RecommendationChangeChoice">
                              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                        Foreground="{DynamicResource BS.Brush.FgPrimary}">
                                <StackPanel Spacing="1">
                                  <TextBlock Classes="mono" FontSize="12" Text="{Binding Pattern}"/>
                                  <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}">
                                    <Run Text="{Binding GroupLabel}"/><Run Text=" · "/><Run Text="{Binding EffectLabel}"/>
                                  </TextBlock>
                                </StackPanel>
                              </CheckBox>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasRecommendedRemovals}" Spacing="2">
                      <TextBlock Classes="label-caps" Text="{Binding RecommendedRemovals.Count, StringFormat='TO REMOVE ({0})'}"/>
                      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecommendedRemovals}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RecommendationChangeChoice">
                              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                        Foreground="{DynamicResource BS.Brush.FgPrimary}">
                                <StackPanel Spacing="1">
                                  <TextBlock Classes="mono" FontSize="12" Text="{Binding Pattern}"/>
                                  <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}">
                                    <Run Text="{Binding GroupLabel}"/><Run Text=" · "/><Run Text="{Binding EffectLabel}"/>
                                  </TextBlock>
                                </StackPanel>
                              </CheckBox>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="primary" Content="Use ticked suggestions" Command="{Binding ApplyRecommendationUpdateCommand}"/>
                      <Button Classes="ghost" Content="Hide all" Command="{Binding IgnoreRecommendationUpdateCommand}"
                              ToolTip.Tip="Hide every suggestion for this backup. Its rules stay as they are."/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Suggestions declined earlier stay available (U067). -->
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasHiddenRecommendations}">
                  <TextBlock Classes="helper" Margin="0" VerticalAlignment="Center"
                             Text="{Binding HiddenRecommendationsText}"/>
                  <Button Classes="ghost" Content="Show hidden suggestions" Command="{Binding ShowHiddenRecommendationsCommand}"/>
                </StackPanel>

                <!-- Recommended exclusions card (U165 follow-up, 10 November
                     2026). Each group says where it stands for this backup:
                     "In place" when the saved backup has it, "Will be added /
                     removed / change when you save" when the tick differs from
                     what is saved, "Not used" otherwise. A tick rewrites the
                     group's part of the recommended block at once. -->
                <Border Classes="surface" Name="RecommendedCard">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section-title" Text="Recommended exclusions" Margin="0"/>

                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,12,Auto">
                        <CheckBox IsChecked="{Binding RecExcludeEssentials}" Name="EssentialsGroup"
                                  Foreground="{DynamicResource BS.Brush.FgPrimary}">
                          <StackPanel Spacing="1">
                            <TextBlock Text="Essentials" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}"
                                       Text="Files no one needs in a backup: page and hibernation files, System Volume Information, the Recycle Bin, Windows setup and upgrade leftovers, Windows.old, boot files, Windows app shortcuts a backup can't store."/>
                          </StackPanel>
                        </CheckBox>
                        <ContentControl Grid.Column="2" Name="EssentialsStatus" VerticalAlignment="Top"
                                        Content="{Binding EssentialsState}" ContentTemplate="{StaticResource GroupStatusPill}"/>
                      </Grid>
                      <ContentControl Margin="28,0,0,0" Content="{Binding EssentialsState}" ContentTemplate="{StaticResource GroupRules}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,12,Auto">
                        <CheckBox IsChecked="{Binding RecExcludeWindowsSystem}" Name="WindowsSystemGroup"
                                  Foreground="{DynamicResource BS.Brush.FgPrimary}">
                          <StackPanel Spacing="1">
                            <TextBlock Text="Windows system files" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}"
                                       Text="The Windows folder, the search index, installer and update caches, driver setup folders. Reinstalling Windows brings them back."/>
                          </StackPanel>
                        </CheckBox>
                        <ContentControl Grid.Column="2" Name="WindowsSystemStatus" VerticalAlignment="Top"
                                        Content="{Binding WindowsSystemState}" ContentTemplate="{StaticResource GroupStatusPill}"/>
                      </Grid>
                      <ContentControl Margin="28,0,0,0" Content="{Binding WindowsSystemState}" ContentTemplate="{StaticResource GroupRules}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,12,Auto">
                        <CheckBox IsChecked="{Binding RecExcludeCachesAndJunk}" Name="CachesGroup"
                                  Foreground="{DynamicResource BS.Brush.FgPrimary}">
                          <StackPanel Spacing="1">
                            <TextBlock Text="App caches and temporary files" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}"
                                       Text="Browser caches, GPU and shader caches, Windows temp folders, *.tmp, node_modules, .DS_Store and similar files apps rebuild by themselves."/>
                          </StackPanel>
                        </CheckBox>
                        <ContentControl Grid.Column="2" Name="CachesStatus" VerticalAlignment="Top"
                                        Content="{Binding CachesState}" ContentTemplate="{StaticResource GroupStatusPill}"/>
                      </Grid>
                      <ContentControl Margin="28,0,0,0" Content="{Binding CachesState}" ContentTemplate="{StaticResource GroupRules}"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasDetectedCloudFolders}" Spacing="4">
                      <TextBlock Classes="label-caps" Text="CLOUD-SYNCED FOLDERS DETECTED"/>
                      <TextBlock Classes="helper" Margin="0,0,0,2" TextWrapping="Wrap"
                                 Text="These folders are already replicated in their providers' clouds. Leaving them out avoids keeping a second copy in your backup."/>
                      <ItemsControl ItemsSource="{Binding DetectedCloudFolders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:CloudExcludeChoice">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Margin="0,2"
                                      Foreground="{DynamicResource BS.Brush.FgPrimary}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Label}"/>
                                <TextBlock Classes="mono" FontSize="12"
                                           Foreground="{DynamicResource BS.Brush.FgDim}"
                                           Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="520"/>
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Grid (not StackPanel Horizontal) so the estimate wraps. -->
                    <Grid ColumnDefinitions="Auto,*">
                      <Button Grid.Column="0" Classes="ghost" VerticalAlignment="Center" Margin="0,0,14,0"
                              Content="Estimate savings"
                              IsVisible="{Binding CanEstimateSavings}"
                              Command="{Binding EstimateSavingsCommand}"/>
                      <TextBlock Grid.Column="1" Classes="dim" FontSize="12"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource BS.Brush.FgSecondary}"
                                 VerticalAlignment="Center"
                                 Text="{Binding RecEstimatedSavingsLabel}"
                                 IsVisible="{Binding RecEstimatedSavingsLabel, Converter={x:Static vm:NotEmpty.To}}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Whether Backspace's updated lists reach this backup by
                     themselves (U165). Set up only in Easy mode: on; opening
                     Advanced from Easy turns it off. Saved like any setting. -->
                <Border Classes="surface" Name="AutoApplyCard">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="section-title" Text="When Backspace updates these lists" Margin="0"/>
                    <CheckBox IsChecked="{Binding AutoApplyRecommendations}" Name="AutoApplyRecommendations"
                              Content="Keep this backup's lists up to date automatically"
                              Foreground="{DynamicResource BS.Brush.FgPrimary}"/>
                    <TextBlock Classes="helper" Margin="28,0,0,0" TextWrapping="Wrap"
                               Text="On: when a Backspace update adds or changes a rule in a ticked group, this backup gets it without asking, and a rule Backspace no longer recommends is removed. Suggestions you hid are never added back. Off: the backup's card shows New filter suggestions, and nothing changes until you review them here."/>
                  </StackPanel>
                </Border>

                <!-- Trailing sentinel — same reasoning as the other
                     tabs. Forces the ScrollViewer's measured extent
                     a clear step beyond the last card so layout-
                     measure rounding never clips the bottom row. -->
                <Border Height="20" Background="Transparent"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Advanced sub-tab (U177, 10 November 2026): the rules at full
               width on Rules; what they leave out on Left out, shown only
               once the person runs it. -->
          <TabItem Header="Advanced" Name="AdvancedFiltersTab">
            <TabControl Classes="sub" Margin="0,4,0,0" Padding="0" Name="AdvancedSubTabs">
              <TabItem Header="Rules" Name="RulesTab">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                  <TextBlock Grid.Row="0" Name="RuleSyntax"
                             Classes="dim" FontSize="13" Margin="0,0,0,8"
                             TextWrapping="Wrap"
                             ToolTip.Tip="Backspace hands this text to restic unchanged, as an exclude file (--iexclude-file on Windows, where upper and lower case don't matter; --exclude-file on macOS and Linux). Everything no rule excludes is backed up."
                             Text="{x:Static vm:BackupEditorViewModel.RuleSyntaxHint}"/>
                  <StackPanel Grid.Row="1">
                    <!-- U151: restic refuses the whole list for one invalid rule. -->
                    <Border Name="InvalidRuleWarning" Margin="0,0,0,12"
                            IsVisible="{Binding FilterInvalidWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{DynamicResource BS.Brush.WarnTint}" BorderBrush="{DynamicResource BS.Brush.Warn}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                      <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="restic can't read these rules, so the backup would stop. Fix or remove them:" TextWrapping="Wrap"/>
                        <TextBlock Classes="mono" FontSize="12" Text="{Binding FilterInvalidWarning}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <!-- U127: an exception below a folder excluded whole keeps nothing. -->
                    <Border Name="DeadExceptionWarning" Margin="0,0,0,12"
                            IsVisible="{Binding FilterExceptionWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{DynamicResource BS.Brush.WarnTint}" BorderBrush="{DynamicResource BS.Brush.Warn}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                      <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="An exception in these rules keeps nothing" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FilterExceptionWarning}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Border Grid.Row="2"
                          BorderBrush="{DynamicResource BS.Brush.BorderSubtle}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource BS.CornerRadiusSmall}">
                    <TextBox Text="{Binding FiltersText}" Name="RulesEditor"
                             Classes="pane"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="{DynamicResource BS.Font.Mono}"
                             FontSize="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             AutomationProperties.Name="Rules, saved with the backup"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"/>
                  </Border>
                </Grid>
              </TabItem>

              <!-- What these rules leave out (U177): one row per topmost item,
                   sorted by size, with the rule responsible. -->
              <TabItem Header="Left out" Name="LeftOutTab">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,8,0,0">
                  <Grid Grid.Row="0" ColumnDefinitions="Auto,12,*" Margin="0,0,0,10">
                    <Panel Grid.Column="0">
                      <Button Classes="primary" Content="Run" Name="RunLeftOut" MinWidth="88"
                              IsVisible="{Binding LeftOutIdle}"
                              ToolTip.Tip="Reads this backup's folders with these rules, as the backup will. Nothing is read until you run it."
                              Command="{Binding RunLeftOutCommand}"/>
                      <Button Classes="ghost" Content="Stop" Name="CancelLeftOut" MinWidth="88"
                              ToolTip.Tip="Stops reading. Nothing changes in the rules."
                              IsVisible="{Binding LeftOutRunning}"
                              Command="{Binding CancelLeftOutCommand}"/>
                    </Panel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Classes="section-title" FontSize="15" Margin="0" Text="What these rules leave out"/>
                      <TextBlock FontSize="12" TextWrapping="Wrap" Name="LeftOutProgressLine"
                                 Foreground="{DynamicResource BS.Brush.FgSecondary}"
                                 IsVisible="{Binding LeftOutRunning}" Text="{Binding LeftOutProgress}"/>
                      <TextBlock FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource BS.Brush.FgSecondary}"
                                 IsVisible="{Binding LeftOutIdle}"
                                 Text="Each folder left out is listed once, with what it holds; a file alone only when its folder is kept. Click a rule to see it on the Rules tab."/>
                    </StackPanel>
                  </Grid>

                  <!-- The rules changed after the run. -->
                  <Border Grid.Row="1" Name="LeftOutStaleNotice" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                          Background="{DynamicResource BS.Brush.WarnTint}" IsVisible="{Binding LeftOutStale}">
                    <Grid ColumnDefinitions="Auto,8,*">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource BS.Brush.Warn}"/>
                      <TextBlock Grid.Column="2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                 Text="The rules changed since this run. Run it again to see what they leave out now."/>
                    </Grid>
                  </Border>

                  <Grid Grid.Row="2" ColumnDefinitions="*,12,Auto,8,Auto" Margin="0,0,0,8" IsVisible="{Binding HasLeftOutResult}">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Name="LeftOutTotal" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LeftOutTotal}"/>
                      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text="{Binding LeftOutDetail}"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Name="LeftOutSearch" Width="220" VerticalAlignment="Center"
                             Watermark="Search paths and rules" Text="{Binding LeftOutSearch}"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Height="32" VerticalAlignment="Center">
                      <Button Classes="toggle-segment toggle-segment-left" Content="By item" Name="LeftOutByItemButton"
                              Classes.toggle-segment-active="{Binding !LeftOutByRule}"
                              Command="{Binding ShowLeftOutByItemCommand}"/>
                      <Button Classes="toggle-segment toggle-segment-right" Content="By rule" Name="LeftOutByRuleButton"
                              Classes.toggle-segment-active="{Binding LeftOutByRule}"
                              Command="{Binding ShowLeftOutByRuleCommand}"/>
                    </StackPanel>
                  </Grid>

                  <Panel Grid.Row="3">
                    <Border IsVisible="{Binding LeftOutEmptyState}" Classes="surface" VerticalAlignment="Top" Name="LeftOutEmpty">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="See what these rules leave out before the backup does."/>
                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}"
                                   Text="Run reads this backup's folders with the rules as they are on the Rules tab, the way the backup reads them. It can take a while on a whole drive; you can stop it. Folders it can't read and online-only files are counted apart."/>
                      </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding LeftOutMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="surface" VerticalAlignment="Top">
                      <TextBlock FontSize="13" TextWrapping="Wrap" Name="LeftOutMessageText" Text="{Binding LeftOutMessage}"/>
                    </Border>
                    <ListBox Name="LeftOutList" ItemsSource="{Binding LeftOutRows}" IsVisible="{Binding HasLeftOutResult}"
                             Background="{DynamicResource BS.Brush.BgSurface}" CornerRadius="10" Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="12,6"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.DataTemplates>
                        <DataTemplate DataType="vm:LeftOutHeading">
                          <StackPanel Spacing="2" Margin="0,10,0,2">
                            <TextBlock IsVisible="{Binding HasTitle}" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BS.Brush.FgSecondary}"/>
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:LeftOutGroupRow">
                          <Grid ColumnDefinitions="*,16,Auto,16,Auto" RowDefinitions="Auto,Auto" Margin="{Binding Indent}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono" FontSize="12" Text="{Binding Shown}"
                                       TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Parent}"/>
                            <WrapPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                              <Border IsVisible="{Binding IsNew}" CornerRadius="999" Padding="7,0" Margin="0,1,6,1"
                                      Background="{DynamicResource BS.Brush.WarnTint}">
                                <TextBlock Text="New with your edits" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BS.Brush.WarnTintFg}"/>
                              </Border>
                              <TextBlock FontSize="12" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text="{Binding Kind}"/>
                              <TextBlock FontSize="12" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text=" · left out by "/>
                              <Button Classes="link-text" FontWeight="Normal"
                                      ToolTip.Tip="Show this rule on the Rules tab"
                                      Command="{Binding $parent[ListBox].((vm:BackupEditorViewModel)DataContext).HighlightRuleCommand}"
                                      CommandParameter="{Binding Rule}">
                                <TextBlock FontFamily="{DynamicResource BS.Font.Mono}" FontSize="12" Text="{Binding Rule.Rule}" Foreground="{DynamicResource BS.Brush.Accent}"/>
                              </Button>
                            </WrapPanel>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold" Text="{Binding Size}"/>
                            <Panel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Center" MinWidth="96">
                              <Button Classes="ghost" Name="GroupToggle" Content="{Binding ToggleText}" Padding="10,3" FontSize="12"
                                      ToolTip.Tip="List these items one by one, each with Keep this"
                                      Command="{Binding ToggleCommand}"/>
                            </Panel>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:LeftOutRow">
                          <Grid ColumnDefinitions="*,16,Auto,16,Auto" RowDefinitions="Auto,Auto" Margin="{Binding Indent}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono" FontSize="12" Text="{Binding Shown}"
                                       TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                            <WrapPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                              <Border IsVisible="{Binding IsNew}" CornerRadius="999" Padding="7,0" Margin="0,1,6,1"
                                      Background="{DynamicResource BS.Brush.WarnTint}">
                                <TextBlock Text="New with your edits" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BS.Brush.WarnTintFg}"/>
                              </Border>
                              <TextBlock FontSize="12" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text="{Binding Kind}"/>
                              <TextBlock FontSize="12" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text=" · left out by "/>
                              <Button Classes="link-text" FontWeight="Normal" Name="RuleLink"
                                      ToolTip.Tip="Show this rule on the Rules tab"
                                      Command="{Binding $parent[ListBox].((vm:BackupEditorViewModel)DataContext).HighlightRuleCommand}"
                                      CommandParameter="{Binding Rule}">
                                <TextBlock FontFamily="{DynamicResource BS.Font.Mono}" FontSize="12" Text="{Binding Rule.Rule}" Foreground="{DynamicResource BS.Brush.Accent}"/>
                              </Button>
                            </WrapPanel>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold" Text="{Binding Size}"/>
                            <Panel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Center" MinWidth="96">
                              <Button Classes="ghost" Content="Keep this" IsVisible="{Binding CanKeep}" Padding="10,3" FontSize="12"
                                      ToolTip.Tip="Adds an exception (!) for this item at the end of the rules, so the backup keeps it. Save keeps the change."
                                      Command="{Binding $parent[ListBox].((vm:BackupEditorViewModel)DataContext).KeepThisCommand}"
                                      CommandParameter="{Binding}"/>
                              <TextBlock IsVisible="{Binding Kept}" FontSize="12" TextWrapping="Wrap" MaxWidth="150"
                                         Foreground="{DynamicResource BS.Brush.SuccessTintFg}"
                                         Text="Kept by a new exception; Save keeps it"/>
                            </Panel>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:LeftOutRuleRow">
                          <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Grid.Column="0" Spacing="1">
                              <Button Classes="link-text" FontWeight="Normal" HorizontalAlignment="Left"
                                      ToolTip.Tip="Show this rule on the Rules tab"
                                      Command="{Binding $parent[ListBox].((vm:BackupEditorViewModel)DataContext).HighlightRuleCommand}"
                                      CommandParameter="{Binding Rule}">
                                <TextBlock FontFamily="{DynamicResource BS.Font.Mono}" FontSize="12" Text="{Binding Rule.Rule}" Foreground="{DynamicResource BS.Brush.Accent}"/>
                              </Button>
                              <TextBlock FontSize="12" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text="{Binding Detail}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding Size}"/>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:LeftOutBackInRow">
                          <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Grid.Column="0" Spacing="1">
                              <TextBlock Classes="mono" FontSize="12" Text="{Binding Shown}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                              <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text="{Binding Kind}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BS.Brush.SuccessTintFg}" Text="{Binding Size}"/>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:LeftOutUnusedRow">
                          <StackPanel Spacing="1">
                            <Button Classes="link-text" FontWeight="Normal" HorizontalAlignment="Left"
                                    ToolTip.Tip="Show this rule on the Rules tab"
                                    Command="{Binding $parent[ListBox].((vm:BackupEditorViewModel)DataContext).HighlightRuleCommand}"
                                    CommandParameter="{Binding Rule}">
                              <TextBlock FontFamily="{DynamicResource BS.Font.Mono}" FontSize="12" Text="{Binding Rule.Rule}" Foreground="{DynamicResource BS.Brush.Accent}"/>
                            </Button>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BS.Brush.FgSecondary}" Text="{Binding Why}"/>
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:LeftOutPathRow">
                          <TextBlock Classes="mono" FontSize="12" Text="{Binding Shown}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                        </DataTemplate>
                      </ListBox.DataTemplates>
                    </ListBox>
                  </Panel>
                </Grid>
              </TabItem>
            </TabControl>
          </TabItem>
        </TabControl>
      </TabItem>

    </TabControl>

    <!-- Footer. Validation summary is rendered here (NOT inside the
         tab content) so it's always visible alongside the Save/Cancel
         row — the previous placement at the top of the Overview tab
         scrolled offscreen the moment the user moved down the form,
         which made "why is Save disabled?" hard to debug. -->
    <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
      <Border Classes="validation-summary" IsVisible="{Binding HasAnyError}">
        <!-- Grid (not StackPanel Horizontal) so wrap can actually wrap. -->
        <Grid ColumnDefinitions="Auto,10,*">
          <TextBlock Grid.Column="0" Text="!" FontSize="18" FontWeight="Bold" VerticalAlignment="Top"
                     Foreground="{DynamicResource BS.Brush.DangerTintFg}"/>
          <TextBlock Grid.Column="2" Classes="body" FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{DynamicResource BS.Brush.DangerTintFg}"
                     Text="{Binding SummaryError}"/>
        </Grid>
      </Border>
      <!-- Probe-warning banner. Amber tone (Warn brush) so it visually
           distinguishes from the red error block above — this is a
           "are you sure?" message, not a hard block. The first save
           click that triggers it returns null; a second click passes
           through. The text in the banner explains why. -->
      <Border IsVisible="{Binding HasProbeWarning}"
              Background="{DynamicResource BS.Brush.WarnTint}"
              BorderBrush="{DynamicResource BS.Brush.Warn}"
              BorderThickness="1"
              CornerRadius="{DynamicResource BS.CornerRadiusSmall}"
              Padding="14,10">
        <Grid ColumnDefinitions="Auto,10,*">
          <TextBlock Grid.Column="0" Text="!" FontSize="18" FontWeight="Bold" VerticalAlignment="Top"
                     Foreground="{DynamicResource BS.Brush.WarnTintFg}"/>
          <TextBlock Grid.Column="2" Classes="body" TextWrapping="Wrap"
                     Foreground="{DynamicResource BS.Brush.FgPrimary}"
                     Text="{Binding ProbeWarning}"/>
        </Grid>
      </Border>
      <!-- Include files that are in use: asked while creating a backup
           that uses VSS, applied right after Save (U026). -->
      <Panel IsVisible="{Binding UseVss}">
        <v:AdministratorAccessChoiceView x:Name="AdministratorAccessChoice" DataContext="{Binding AdministratorAccess}"/>
      </Panel>
      <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Classes="dim" FontSize="12"
                 VerticalAlignment="Center"
                 Text="{Binding SaveStatus}"
                 IsVisible="{Binding SaveStatus, Converter={x:Static vm:NotEmpty.To}}"/>
      <!-- Filter changes wait for Save (U165 follow-up): said beside the
           button that keeps them, wherever the person is in the window. -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Name="UnsavedFilters">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="FiltersUnsaved"/>
            <Binding Path="SaveStatus" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
          </MultiBinding>
        </StackPanel.IsVisible>
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource BS.Brush.Warn}"/>
        <TextBlock FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource BS.Brush.FgSecondary}"
                   Text="Filter changes not saved yet"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Classes="ghost" Content="Cancel" Click="OnCancel"
                IsEnabled="{Binding !SaveBusy}"/>
        <Button Classes="ghost" Content="Save &amp; Run" Click="OnSaveAndRun"
                IsEnabled="{Binding !SaveBusy}"/>
        <Button Classes="primary" Content="Save" Click="OnSave"
                IsEnabled="{Binding !SaveBusy}"/>
      </StackPanel>
      </Grid>
    </StackPanel>

  </Grid>
</Window>
