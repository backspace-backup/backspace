index 4f258d8..d53254b 100644
--- a/internal/fs/stat_windows_test.go
+++ b/internal/fs/stat_windows_test.go
@@ -34,16 +34,17 @@ func TestRecallOnDataAccessRealFile(t *testing.T) {
 // mockFileInfo implements os.FileInfo for mocking file attributes
 type mockFileInfo struct {
 	FileAttributes uint32
+	mode           iofs.FileMode
 }
 
 func (m mockFileInfo) IsDir() bool {
-	return false
+	return m.mode.IsDir()
 }
 func (m mockFileInfo) ModTime() time.Time {
 	return time.Now()
 }
 func (m mockFileInfo) Mode() iofs.FileMode {
-	return 0
+	return m.mode
 }
 func (m mockFileInfo) Name() string {
 	return "test"
@@ -78,3 +79,54 @@ func TestRecallOnDataAccessMockRegularFile(t *testing.T) {
 	rtest.Assert(t, err == nil, "err should be nil", err)
 	rtest.Assert(t, recall == false, "RecallOnDataAccess should be false")
 }
+
+func TestRecallOnDataAccessMockPlaceholders(t *testing.T) {
+	const pinned = 0x00080000 // FILE_ATTRIBUTE_PINNED
+	for _, test := range []struct {
+		name  string
+		attrs uint32
+		mode  iofs.FileMode
+		cloud bool
+	}{
+		// A Dropbox online-only file as an ordinary process sees it:
+		// ARCHIVE | SPARSE_FILE | REPARSE_POINT | OFFLINE, an irregular file.
+		{"dropbox online-only", 0x1620, iofs.ModeIrregular, true},
+		{"offline", windows.FILE_ATTRIBUTE_OFFLINE, 0, true},
+		{"recall on open", windows.FILE_ATTRIBUTE_RECALL_ON_OPEN, 0, true},
+		{"onedrive online-only", windows.FILE_ATTRIBUTE_ARCHIVE | windows.FILE_ATTRIBUTE_REPARSE_POINT |
+			windows.FILE_ATTRIBUTE_RECALL_ON_DATA_ACCESS, iofs.ModeIrregular, true},
+		{"folder recall on data access", windows.FILE_ATTRIBUTE_DIRECTORY | windows.FILE_ATTRIBUTE_RECALL_ON_DATA_ACCESS, iofs.ModeDir, true},
+		// Not online-only.
+		{"regular", windows.FILE_ATTRIBUTE_ARCHIVE, 0, false},
+		{"sparse", windows.FILE_ATTRIBUTE_ARCHIVE | windows.FILE_ATTRIBUTE_SPARSE_FILE, 0, false},
+		{"downloaded placeholder", windows.FILE_ATTRIBUTE_ARCHIVE | windows.FILE_ATTRIBUTE_REPARSE_POINT, iofs.ModeIrregular, false},
+		{"pinned", windows.FILE_ATTRIBUTE_ARCHIVE | pinned, 0, false},
+		{"symlink", windows.FILE_ATTRIBUTE_ARCHIVE | windows.FILE_ATTRIBUTE_REPARSE_POINT, iofs.ModeSymlink, false},
+		{"folder offline", windows.FILE_ATTRIBUTE_DIRECTORY | windows.FILE_ATTRIBUTE_OFFLINE, iofs.ModeDir, false},
+		{"folder recall on open", windows.FILE_ATTRIBUTE_DIRECTORY | windows.FILE_ATTRIBUTE_RECALL_ON_OPEN, iofs.ModeDir, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			xs := fs.ExtendedStat(mockFileInfo{FileAttributes: test.attrs, mode: test.mode})
+			recall, err := xs.RecallOnDataAccess()
+			rtest.OK(t, err)
+			rtest.Equals(t, test.cloud, recall)
+			rtest.Equals(t, test.cloud, fs.IsCloudPlaceholder(test.attrs, test.mode.IsDir()))
+		})
+	}
+}
+
+func TestRecallOnDataAccessOfflineRealFile(t *testing.T) {
+	// A local file marked offline is detected from what Lstat read.
+	tempdir := rtest.TempDir(t)
+	filename := filepath.Join(tempdir, "offline-file")
+	rtest.OK(t, os.WriteFile(filename, []byte("foobar"), 0640))
+	name, err := windows.UTF16PtrFromString(filename)
+	rtest.OK(t, err)
+	rtest.OK(t, windows.SetFileAttributes(name, windows.FILE_ATTRIBUTE_OFFLINE))
+
+	fi, err := os.Lstat(filename)
+	rtest.OK(t, err)
+	recall, err := fs.ExtendedStat(fi).RecallOnDataAccess()
+	rtest.OK(t, err)
+	rtest.Assert(t, recall, "a file marked offline should be online-only")
+}
-- 
