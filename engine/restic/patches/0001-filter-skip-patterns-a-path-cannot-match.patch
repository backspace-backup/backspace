diff --git a/internal/filter/filter.go b/internal/filter/filter.go
index c2b5f98ce..f979782a8 100644
--- a/internal/filter/filter.go
+++ b/internal/filter/filter.go
@@ -2,6 +2,7 @@ package filter
 
 import (
 	"path/filepath"
+	"slices"
 	"strings"
 
 	"github.com/restic/restic/internal/errors"
@@ -21,6 +22,14 @@ type Pattern struct {
 	original  string
 	parts     []patternPart
 	isNegated bool
+
+	// A match places every part of the pattern on one component of the
+	// path. A path therefore cannot match unless it has each plain part
+	// as a component (requiredParts) and contains the longest literal
+	// text of each wildcard part (requiredText). list uses this to skip
+	// most patterns for most paths without running match.
+	requiredParts []string
+	requiredText  []string
 }
 
 func prepareStr(str string) ([]string, error) {
@@ -52,7 +61,69 @@ func preparePattern(patternStr string) Pattern {
 		parts[i] = patternPart{part, isSimple}
 	}
 
-	return Pattern{originalPattern, parts, negate}
+	return Pattern{original: originalPattern, parts: parts, isNegated: negate}
+}
+
+// withRequirements sets what a path must contain to match, for list. An
+// absolute pattern without "**" is compared at one position only, which is
+// already as cheap as checking the requirements.
+func (pattern Pattern) withRequirements() Pattern {
+	if ok, _ := hasDoubleWildcard(pattern); ok || len(pattern.parts) == 0 || pattern.parts[0].pattern != "/" {
+		pattern.requiredParts, pattern.requiredText = requirements(pattern.parts)
+	}
+	return pattern
+}
+
+// requirements returns what every path matching parts must contain: the
+// plain parts, as whole components, and the longest literal run of each
+// wildcard part, as text. A pattern with a malformed part gets no
+// requirements, so that match still reports the error for every path.
+func requirements(parts []patternPart) (requiredParts []string, requiredText []string) {
+	// Last parts first: they are the most specific, so a path usually
+	// fails on the first one checked.
+	for _, part := range slices.Backward(parts) {
+		if part.pattern == "" || part.pattern == "/" {
+			continue
+		}
+		if part.isSimple {
+			requiredParts = append(requiredParts, part.pattern)
+			continue
+		}
+		if _, err := filepath.Match(part.pattern, part.pattern); err != nil {
+			return nil, nil
+		}
+		// Character classes and escapes are left out: their literal text
+		// is not simply a substring of what they match.
+		if strings.ContainsAny(part.pattern, `\[]`) {
+			continue
+		}
+		longest := ""
+		for _, run := range strings.FieldsFunc(part.pattern, func(r rune) bool { return r == '*' || r == '?' }) {
+			if len(run) > len(longest) {
+				longest = run
+			}
+		}
+		if longest != "" {
+			requiredText = append(requiredText, longest)
+		}
+	}
+	return requiredParts, requiredText
+}
+
+// mayMatch reports whether pattern can match the path str, split into strs.
+// It is false only for paths that match cannot match.
+func (pattern Pattern) mayMatch(str string, strs []string) bool {
+	for _, part := range pattern.requiredParts {
+		if !slices.Contains(strs, part) {
+			return false
+		}
+	}
+	for _, text := range pattern.requiredText {
+		if !strings.Contains(str, text) {
+			return false
+		}
+	}
+	return true
 }
 
 // Split p into path components. Assuming p has been Cleaned, no component
@@ -136,7 +207,7 @@ func childMatch(pattern Pattern, strs []string) (matched bool, err error) {
 	} else {
 		l = len(strs)
 	}
-	return match(Pattern{pattern.original, pattern.parts[0:l], pattern.isNegated}, strs)
+	return match(Pattern{original: pattern.original, parts: pattern.parts[0:l], isNegated: pattern.isNegated}, strs)
 }
 
 func hasDoubleWildcard(list Pattern) (ok bool, pos int) {
@@ -164,7 +235,7 @@ func match(pattern Pattern, strs []string) (matched bool, err error) {
 			}
 			newPat = append(newPat, pattern.parts[pos+1:]...)
 
-			matched, err := match(Pattern{pattern.original, newPat, pattern.isNegated}, strs)
+			matched, err := match(Pattern{original: pattern.original, parts: newPat, isNegated: pattern.isNegated}, strs)
 			if err != nil {
 				return false, err
 			}
@@ -262,7 +333,7 @@ func ParsePatterns(pattern []string) []Pattern {
 			continue
 		}
 
-		pats := preparePattern(pat)
+		pats := preparePattern(pat).withRequirements()
 		patpat = append(patpat, pats)
 	}
 	return patpat
@@ -300,9 +371,12 @@ func list(patterns []Pattern, checkChildMatches bool, str string) (matched bool,
 	}
 
 	for _, pat := range patterns {
-		m, err := match(pat, strs)
-		if err != nil {
-			return false, false, err
+		var m bool
+		if pat.mayMatch(str, strs) {
+			m, err = match(pat, strs)
+			if err != nil {
+				return false, false, err
+			}
 		}
 
 		var c bool
diff --git a/internal/filter/filter_requirements_test.go b/internal/filter/filter_requirements_test.go
new file mode 100644
index 000000000..9ac41edb4
--- /dev/null
+++ b/internal/filter/filter_requirements_test.go
@@ -0,0 +1,126 @@
+package filter_test
+
+import (
+	"math/rand"
+	"strings"
+	"testing"
+
+	"github.com/restic/restic/internal/filter"
+)
+
+// referenceList evaluates patterns one at a time with Match (and ChildMatch
+// when withChild is set, as ListWithChild does), which do not use the
+// requirements List checks first.
+func referenceList(patterns []string, str string, withChild bool) (matched bool, childMayMatch bool, err error) {
+	hasNegated := false
+	for _, p := range patterns {
+		hasNegated = hasNegated || strings.HasPrefix(p, "!")
+	}
+	for _, p := range patterns {
+		negated := strings.HasPrefix(p, "!")
+		p = strings.TrimPrefix(p, "!")
+		m, err := filter.Match(p, str)
+		if err != nil {
+			return false, false, err
+		}
+		// list computes the child match of negated patterns too.
+		c := true
+		if withChild {
+			c, err = filter.ChildMatch(p, str)
+			if err != nil {
+				return false, false, err
+			}
+		}
+		if negated {
+			matched = matched && !m
+			childMayMatch = childMayMatch && !m
+			continue
+		}
+		matched = matched || m
+		childMayMatch = childMayMatch || c
+		if matched && childMayMatch && !hasNegated {
+			break
+		}
+	}
+	return matched, childMayMatch, nil
+}
+
+// List skips a pattern when the path lacks text every match needs. The
+// result must be the same as matching every pattern, for any patterns.
+func TestListRequirementsKeepResults(t *testing.T) {
+	names := []string{"a", "b", "foo", "foo.txt", "bar.tmp", "node_modules", "Cache", "x.cache", "$RECYCLE.BIN", "sdk", "cpp"}
+	globs := []string{"*", "**", "*.tmp", "*cache*", "*Cache", "f?o*", "[ab]", "?", "*.txt", "*$RECYCLE.BIN", "["}
+	r := rand.New(rand.NewSource(1))
+	part := func() string {
+		if r.Intn(3) == 0 {
+			return globs[r.Intn(len(globs))]
+		}
+		return names[r.Intn(len(names))]
+	}
+	pattern := func() string {
+		parts := make([]string, 1+r.Intn(4))
+		for i := range parts {
+			parts[i] = part()
+		}
+		p := strings.Join(parts, "/")
+		if r.Intn(3) == 0 {
+			p = "/" + p
+		}
+		if r.Intn(6) == 0 {
+			p = "!" + p
+		}
+		return p
+	}
+	path := func() string {
+		parts := make([]string, 1+r.Intn(8))
+		for i := range parts {
+			parts[i] = names[r.Intn(len(names))]
+		}
+		return "/" + strings.Join(parts, "/")
+	}
+
+	for round := 0; round < 2000; round++ {
+		patterns := make([]string, 1+r.Intn(8))
+		for i := range patterns {
+			patterns[i] = pattern()
+		}
+		parsed := filter.ParsePatterns(patterns)
+		for i := 0; i < 50; i++ {
+			str := path()
+			wantMatch, wantChild, wantErr := referenceList(patterns, str, true)
+			gotMatch, gotChild, gotErr := filter.ListWithChild(parsed, str)
+			if (gotErr != nil) != (wantErr != nil) || gotMatch != wantMatch || gotChild != wantChild {
+				t.Fatalf("patterns %q, path %q: got (%v, %v, %v), want (%v, %v, %v)",
+					patterns, str, gotMatch, gotChild, gotErr, wantMatch, wantChild, wantErr)
+			}
+			wantMatch, _, wantErr = referenceList(patterns, str, false)
+			listMatch, listErr := filter.List(parsed, str)
+			if (listErr != nil) != (wantErr != nil) || listMatch != wantMatch {
+				t.Fatalf("List: patterns %q, path %q: got (%v, %v), want (%v, %v)", patterns, str, listMatch, listErr, wantMatch, wantErr)
+			}
+		}
+	}
+}
+
+// Rules as found in real Windows exclude lists: most name a folder, many
+// use "**", and nearly every path matches none of them.
+func BenchmarkFilterManyRules(b *testing.B) {
+	lines := extractTestLines(b)
+	var patterns []string
+	for _, dir := range []string{"node_modules", "Cache", "GPUCache", "ShaderCache", "npm-cache", "__pycache__", "Temp", "Logs", "CrashDumps", "INetCache"} {
+		patterns = append(patterns, "**/"+dir+"/", "/home/**/"+dir+"/*", "/usr/*/**/"+dir+"/*")
+	}
+	for _, ext := range []string{"*.tmp", "*.temp", "*.dmp", "*.crdownload", "*~", "*.swp", "*.bak", "*.log"} {
+		patterns = append(patterns, ext, "/usr/**/"+ext)
+	}
+	parsed := filter.ParsePatterns(patterns)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		for _, line := range lines {
+			if _, err := filter.List(parsed, line); err != nil {
+				b.Fatal(err)
+			}
+		}
+	}
+}
