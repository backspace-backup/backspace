<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows: the full app. Linux and macOS (or -p:CrossPlatformTests=true
         on Windows, to try that build): the cross-platform app (U235). -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT' and '$(CrossPlatformTests)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT' or '$(CrossPlatformTests)' == 'true'">net10.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Backspace.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      Turn off parallel test execution. Several tests mutate process-wide
      state (env vars, ServiceLocator, Avalonia's Dispatcher) and would
      interfere with each other if run concurrently.
    -->
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit + MS test SDK. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />

    <!-- Avalonia's headless test harness: renders windows without a display,
         lets us assert on resolved layout bounds. Skia is pulled in so we
         can rasterize views to PNG for visual review — without it the
         headless platform only supports layout, not drawing. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />

    <!-- Pixel compare for the screenshot baseline diff. ImageSharp
         decodes PNGs to Rgba32 buffers we can walk directly — no
         System.Drawing.Common (deprecated on non-Windows) needed.
         3.1.5 has known CVEs (NU1903 / NU1902); pinned because newer
         versions have not been validated against these historical
         image baselines. This test-only pin is independent of Skia;
         the warning suppression does not resolve those CVEs. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" NoWarn="NU1902;NU1903" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Services\Fixtures\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Custom artifacts-path outputs are outside the test project's tree.
         The screenshot harness resolves its reference folder beside the test
         assembly there. Always supply the repository's references, including
         when an earlier run auto-created a newer output-only baseline. -->
    <Content Include="artifacts\baseline\**\*.png" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Backspace\Backspace.csproj" />
  </ItemGroup>

  <!--
    Copy the engine binaries (restic + rclone) from the main project's
    Assets/ folder into the test host's bin/ so
    AppPaths.{ResticBinary,RcloneBinary} (which resolve relative to the
    process exe) find them when a test runs restic. AvaloniaResource
    embedding is only active in the app's single-file Release publish;
    Debug + test runs use loose files.

    Evaluate after Build, when the referenced app has fetched its engines.
    Each entry is Condition'd on the file existing so a build with
    `-p:SkipEngineDownload=true` (or a checkout that hasn't run
    FetchEngines.targets yet) doesn't fail; the RealEngineFixture's
    BinariesPresent check reports missing engines. Release checks must
    reject that condition instead of treating an omitted scenario as proof.
  -->
  <Target Name="CopyEngineBinariesForTests" AfterTargets="Build">
  <ItemGroup>
    <TestEngineBinary Include="..\..\src\Backspace\Assets\restic.exe"
             Condition="Exists('..\..\src\Backspace\Assets\restic.exe')"
             Link="restic.exe"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Linux and macOS: no extension (U235). -->
    <TestEngineBinary Include="..\..\src\Backspace\Assets\restic"
             Condition="Exists('..\..\src\Backspace\Assets\restic')"
             Link="restic"
             CopyToOutputDirectory="PreserveNewest" />
    <TestEngineBinary Include="..\..\src\Backspace\Assets\rclone"
             Condition="Exists('..\..\src\Backspace\Assets\rclone')"
             Link="rclone"
             CopyToOutputDirectory="PreserveNewest" />
    <TestEngineBinary Include="..\..\src\Backspace\Assets\rclone.exe"
             Condition="Exists('..\..\src\Backspace\Assets\rclone.exe')"
             Link="rclone.exe"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Copy SourceFiles="@(TestEngineBinary)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- BEGIN windows-only tests -->
